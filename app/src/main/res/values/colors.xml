    <color name="track_on_light">#38FFFFFF</color>
    <color name="track_on_dark">#14FFFFFF</color>
    <!-- ==================================================================
         Weekly leaderboard (handoff: leaderboard redesign).

         Additive, like the home palette above. The place colours are the only
