<?xml version="1.0" encoding="utf-8"?><!--
    One initial in the overlapping cluster on the Recent payouts row. The
    2dp stroke is the page colour, not a border: it punches a gap so the
    circles read as stacked rather than merged.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/violet_tint_30" />
    <stroke android:width="2dp" android:color="@color/surface_card" />
</shape>
