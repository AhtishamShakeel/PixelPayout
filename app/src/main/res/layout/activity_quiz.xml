<?xml version="1.0" encoding="utf-8"?><!--
    The quiz answering screen, built from the Quiz Answer Screen.dc.html
    handoff - variant 1c, "Ring-led".

    The shape of the design, and what it changes from what was here:

      * NO CARDS. The question, the options and the page all sit on the same
        ground, separated by hairlines. The old screen wrapped the question in
        a CardView and every option in another; that is five raised surfaces
        on a screen with one job.
      * THE CLOCK LEADS. A 104dp ring at the top is the only heavy element,
        and the XP line hangs off it. The countdown used to be a 63dp circle
        pinned over the card's edge, which read as decoration on the card
        rather than as the thing the screen is racing.
      * Options are rows with a rail down the left, not stroked pills. The
        rail is what carries selection and the correct/wrong reveal - see
        default_option_background and its three siblings.

    IDS ARE UNCHANGED. questionText, timerText, optionsContainer and
    submitButton are all still here and still mean the same thing, because
    QuizActivity's logic was not part of this change.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- ===== Header =====
         NO WAY OUT. The handoff put a close button here and it has been
         removed along with the back gesture: an attempt is spent the moment
         the quiz opens, so an exit that looked free would not have been. See
         QuizActivity's back callback and onStop.

         The row keeps the 36dp the close button gave it, so removing the
         control did not move everything below it up.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical|end"
        android:minHeight="36dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quizCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/jakarta_semibold"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:textColor="@color/text_faint"
            android:textSize="10.5sp"
            tools:text="General knowledge" />

    </LinearLayout>

    <!-- ===== The clock, and what the question is worth ===== -->
    <FrameLayout
        android:id="@+id/timerContainer"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="26dp">

        <!--
            Determinate, counting DOWN: progress is the seconds remaining, so
            the ring empties as the time does. max is set from the same
            constant the timer counts from.
        -->
        <ProgressBar
            android:id="@+id/timerRing"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bg_quiz_timer_ring"
            android:maxHeight="104dp"
            android:maxWidth="104dp"
            android:minHeight="104dp"
            android:minWidth="104dp" />

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_quiz_timer_well"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/white"
                android:textSize="30sp"
                tools:text="24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jakarta_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:text="@string/quiz_timer_unit"
                android:textAllCaps="true"
                android:textColor="@color/text_ghost"
                android:textSize="9sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bolt"
            app:tint="@color/brand_violet_light" />

        <TextView
            android:id="@+id/quizXpNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/mono_bold"
            android:textColor="@color/brand_violet_light"
            android:textSize="12.5sp"
            tools:text="+10 XP if correct" />

    </LinearLayout>

    <!-- ===== The question ===== -->
    <TextView
        android:id="@+id/questionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/jakarta_bold"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="1.32"
        android:textColor="@color/white"
        android:textSize="23sp"
        tools:text="Which animal has the strongest bite?" />

    <!-- ===== The options =====
         Inflated from item_option.xml by QuizActivity, which calls
         removeAllViews() first - so this container stays empty by design.
         Anything declared here paints for the frames before the first
         question lands, showing a second set of options behind the real ones.
    -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="vertical" />

    <!-- Closes the last row. Each option draws the rule ABOVE itself, which
         leaves the bottom of the list open; a per-row drawable cannot know
         which row is last, so the closing rule lives out here. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_card" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Outlined rather than filled: the ring already owns the violet on this
         screen, and two solid violet shapes would compete. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:fontFamily="@font/jakarta_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/submit_answer"
        android:textAllCaps="false"
        android:textColor="@color/brand_violet_light"
        android:textSize="14.5sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/brand_violet"
        app:strokeWidth="1.5dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/jakarta_medium"
        android:gravity="center"
        android:text="@string/quiz_forfeit_warning"
        android:textColor="@color/text_ghost"
        android:textSize="11sp" />

</LinearLayout>
