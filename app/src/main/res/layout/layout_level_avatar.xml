<?xml version="1.0" encoding="utf-8"?><!--
    Avatar with a level-progress ring around it and the level in a badge.

    This replaces the separate "Lv 12  ·  1,240 / 1,400 XP" row plus its own
    progress bar: progression reads as ambient here instead of competing with
    the redeemable balance for attention.

    The ring and the avatar are BOTH centred in this frame rather than pinned
    with hand-computed margins. CircularProgressIndicator sizes itself from
    indicatorSize plus its track spec, so the circle it draws is not guaranteed
    to fill its own bounds exactly - centring both makes them concentric
    whatever those internal metrics work out to be.

    The frame is 52dp so the 20dp badge can hang off the 48dp ring at the
    bottom-right without being clipped.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/levelAvatarRoot"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:clickable="true"
    android:contentDescription="@string/level_avatar_description"
    android:focusable="true">

    <!--
        Determinate indicator starts at 12 o'clock and runs clockwise, which is
        what the design wants. The track is deliberately thin: the ring is a
        status cue, not a primary control.
    -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/levelRing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        app:indicatorColor="@color/primary"
        app:indicatorSize="48dp"
        app:trackColor="@color/track_dark"
        app:trackCornerRadius="2dp"
        app:trackThickness="2.5dp" />

    <!--
        Padding insets the placeholder glyph inside the circle. When real
        profile photos land, drop the padding and switch to centerCrop so the
        photo fills the circle instead of floating in it.
    -->

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:background="@color/card_dark"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_user_icon"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PixelPayout.Circle" />

    <TextView
        android:id="@+id/levelBadge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_level_badge"
        android:fontFamily="@font/lexend_bold"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        tools:text="12" />

</FrameLayout>
