<?xml version="1.0" encoding="utf-8"?>
<!-- The "Selected reward" row inside the Wallet goal cards: a faint well,
     lighter than the card around it, so it reads as a control and not as a
     second card. The ripple is the tap feedback for the whole row. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26925DEB">
    <item>
        <shape>
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
