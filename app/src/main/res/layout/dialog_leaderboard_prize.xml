<?xml version="1.0" encoding="utf-8"?><!--
    "You placed in the weekly tournament."

    A SETTLEMENT USED TO BE COMPLETELY SILENT. The Monday job credited the
    stars and that was it - the balance went up and nothing anywhere said a
    prize had been won. It is the only reward in this app that a user competes
    for over a whole week, and it was the only one that arrived without a
    word.

    Built on the bones of dialog_reward_paid deliberately. That screen is
    already the app's language for "stars have landed and it is worth
    stopping for": the same takeover, the same bloom, the same falling stars,
    the same medallion-eyebrow-title-figure column over a detail card. A
    second, unrelated celebration design would make two moments that mean the
    same thing look like they came from different apps.

    What differs is what it is celebrating, so the medallion carries a trophy
    with the finishing place on its badge instead of a star with a tick, and
    the detail card lists the three facts that make the figure mean something:
    where they came, what they scored, and out of how many places paid. None
    of it can be recovered from live state by the time this is shown - the
    week has rolled and the board is showing other people - so all of it is
    carried on the prize itself.

    Shown through TakeoverDialogTheme, which is not floating and not dimmed -
    the scrim below is the whole background. Motion is transform and opacity
    only, driven from LeaderboardPrizeNotifier, so it stays cheap on the
    low-end devices most of these users are on.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_takeover"
    android:clipChildren="true">

    <!-- The bloom. Overhangs the top edge and is clipped by this frame. -->
    <View
        android:id="@+id/prizeGlow"
        android:layout_width="520dp"
        android:layout_height="520dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-120dp"
        android:background="@drawable/bg_glow_gold" />

    <!-- The falling stars, placed by horizontal bias so they land on the same
         percentages on any screen width; animated from code. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prizeStarLayer"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/prizeStar1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold" />

        <ImageView
            android:id="@+id/prizeStar2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.26"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold" />

        <ImageView
            android:id="@+id/prizeStar3"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.44"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold" />

        <ImageView
            android:id="@+id/prizeStar4"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.62"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold" />

        <ImageView
            android:id="@+id/prizeStar5"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.78"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold" />

        <ImageView
            android:id="@+id/prizeStar6"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.92"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gold" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/prizeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/prizeClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_ghost_circle"
                android:contentDescription="@string/leaderboard_prize_close"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_dim" />

        </FrameLayout>

        <!-- Centred between the header and the buttons, and scrollable only
             so a short screen cannot push the buttons off the bottom. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="0dp"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/prizeMedallion"
                    android:layout_width="116dp"
                    android:layout_height="116dp">

                    <View
                        android:id="@+id/prizeMedallionRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_medallion_ring" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_medallion_inner" />

                    <!-- A trophy, not a star. The star is the currency and it
                         is already on the figure below; this is the placing. -->
                    <ImageView
                        android:id="@+id/prizeTrophy"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/gold" />

                    <!-- The finishing place, on the badge where the paid
                         dialog puts its tick. Tinted to the metal for the
                         first three and left violet below that, which is the
                         same rule the standings rows follow. -->
                    <TextView
                        android:id="@+id/prizeRankBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/bg_check_badge"
                        android:fontFamily="@font/mono_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/background_dark"
                        android:textSize="12sp"
                        tools:text="#1" />

                </FrameLayout>

                <TextView
                    android:id="@+id/prizeEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="@font/jakarta_semibold"
                    android:letterSpacing="0.1"
                    android:text="@string/leaderboard_prize_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/gold"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/prizeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:gravity="center"
                    android:letterSpacing="-0.03"
                    android:textColor="@color/white"
                    android:textSize="27sp"
                    tools:text="1st place" />

                <TextView
                    android:id="@+id/prizeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/mono_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/gold"
                    android:textSize="40sp"
                    tools:text="350 ★" />

                <TextView
                    android:id="@+id/prizeMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:maxWidth="250dp"
                    android:text="@string/leaderboard_prize_message"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/prizeDetailCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_card_detail"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="11dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/leaderboard_prize_place_label"
                            android:textColor="@color/text_faint"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/prizePlaceValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/mono_bold"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="#1 of 30 paid" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_card" />

                    <!-- Hidden when the settlement carried no XP figure, which
                         only happens on a prize written before this dialog
                         existed. -->
                    <LinearLayout
                        android:id="@+id/prizeXpRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/leaderboard_prize_xp_label"
                            android:textColor="@color/text_faint"
                            android:textSize="11.5sp" />

                        <!-- Violet, because it is XP. The figure above it is
                             gold because it is stars. Same rule as the board. -->
                        <TextView
                            android:id="@+id/prizeXpValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/mono_bold"
                            android:textColor="@color/xp_accent"
                            android:textSize="12sp"
                            tools:text="2,480 XP" />

                    </LinearLayout>

                    <View
                        android:id="@+id/prizeXpRule"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_card" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="11dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/leaderboard_prize_week_label"
                            android:textColor="@color/text_faint"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/prizeWeekValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/mono_bold"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="1–7 Sep" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/prizeFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prizeDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_violet_14"
                android:fontFamily="@font/jakarta_bold"
                android:gravity="center"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="@string/leaderboard_prize_done"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- The one optional action, and it points at THIS week rather
                 than at the week just won: the prize is already banked, and
                 the useful next move is to see where they are standing now. -->
            <LinearLayout
                android:id="@+id/prizeViewBoard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_ghost_12"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/text_dim" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/jakarta_bold"
                    android:text="@string/leaderboard_prize_view_board"
                    android:textColor="@color/text_dim"
                    android:textSize="12.5sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
