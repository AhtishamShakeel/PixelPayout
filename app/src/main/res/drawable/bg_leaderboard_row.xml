<?xml version="1.0" encoding="utf-8"?><!--
    The weekly leaderboard card. Stars border: the board pays a Stars prize pool, which is the only reason a rank on it is worth reading.

    Shared ground, accent in the hairline - the rule every card on Home
    follows. See bg_stat_card_stars.xml for why.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_card" />
    <stroke android:width="1dp" android:color="@color/stars_stroke" />
    <corners android:radius="18dp" />
</shape>
