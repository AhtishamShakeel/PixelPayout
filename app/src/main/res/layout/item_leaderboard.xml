<?xml version="1.0" encoding="utf-8"?><!--
    One place on the weekly board, as a row of a table: rank, user, XP, prize.

    The columns are fixed widths rather than wrapped content so that every row
    lines up under the header in fragment_leaderboard - a table whose columns
    drift with the length of the number in them is not a table. The gap
    between rows is carried here as the root's bottom margin.

    The first three places wear a laurel instead of a numeral; ic_laurel is
    tinted to the metal at bind time and the number sits inside it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/leaderboardItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_row_card"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/leaderboardItemLaurel"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:src="@drawable/ic_laurel"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/leaderboardItemRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/mono_bold"
            android:includeFontPadding="false"
            android:textColor="@color/text_faint"
            android:textSize="12.5sp"
            tools:text="1" />

    </FrameLayout>

    <!-- The initial of an already-masked name. Real avatars, when there are
         any, load into this same well with this same ring. -->
    <TextView
        android:id="@+id/leaderboardItemAvatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_row_avatar"
        android:fontFamily="@font/jakarta_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/text_half"
        android:textSize="11.5sp"
        tools:text="K" />

    <TextView
        android:id="@+id/leaderboardItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/jakarta_bold"
        android:maxLines="1"
        android:textColor="@color/text_strong"
        android:textSize="13sp"
        tools:text="Joh********23" />

    <!-- Bare numerals in both money columns: the header says what they are,
         and repeating "XP" thirty times down a column is noise. -->
    <TextView
        android:id="@+id/leaderboardItemXp"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/mono_medium"
        android:gravity="end"
        android:textColor="@color/text_faint"
        android:textSize="11.5sp"
        tools:text="31,240" />

    <TextView
        android:id="@+id/leaderboardItemPrize"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/mono_bold"
        android:gravity="end"
        android:textColor="@color/gold"
        android:textSize="12sp"
        tools:text="150 ★" />

</LinearLayout>
