<?xml version="1.0" encoding="utf-8"?>
<!-- Account row icon on Profile: an outlined glyph on a small rounded tile,
     the same tile language as the Refer & Earn card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="34dp" android:height="34dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/row_danger_tint" />
            <stroke android:width="1dp" android:color="@color/row_danger_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_row_delete_glyph" android:gravity="center" />
</layer-list>
