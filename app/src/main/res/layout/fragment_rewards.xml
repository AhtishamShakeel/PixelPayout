<?xml version="1.0" encoding="utf-8"?><!--
    Earn: the weekly leaderboard, then the offerwall list.

    THE LEADERBOARD CARD MOVED HERE FROM HOME. Home is a summary of what the
    user already has; Earn is the list of ways to get more, and a weekly prize
    pool is one of those - on Home it was one card among nine, competing with
    the balance and the streak for a glance. Here it is the first thing on a
    screen the user opened for exactly this reason.

    That move is also why MainActivity no longer hides this tab when the
    offerwall catalogue is empty: the tab now has something behind it either
    way. The catalogue flag still decides the list below, and nothing else.

    Three states below the card, and the empty one is the interesting case:
    until a network approves us there are no walls at all, and a screen that
    says "coming soon" next to a dead button is both a bad first impression
    and a plausible Play review rejection. So the list simply explains itself
    and offers nothing to tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <!-- ================= Weekly leaderboard ================= -->
    <!--
        Gold hairline rather than the usual one: this is the competitive card,
        and it is the only place in the app where what a user gets depends on
        what everybody else did.

        The whole card is the tap target, not just the link in its header -
        the link says where it goes, the card is what a thumb hits.

        DRAWN IMMEDIATELY, placeholders and all. It used to be hidden until
        getLeaderboard answered, which on the first call of the day is a cold
        Cloud Function - so the tab opened without it and the card dropped in
        a second or two later, shoving the offer list down as it arrived. The
        card is part of this screen, not a result the screen waits for: the
        furniture is in the layout, and only the four figures inside it come
        from the server.

        The placeholders are em dashes rather than zeroes. A rank of "#0" or a
        prize of "0" are statements about where the user stands, and both are
        false while we are still asking.
    -->
    <LinearLayout
        android:id="@+id/leaderboardRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_leaderboard_row"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_violet">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/xp_accent" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_bold"
                android:maxLines="1"
                android:text="@string/leaderboard_title"
                android:textColor="@color/white"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jakarta_semibold"
                android:text="@string/leaderboard_view"
                android:textColor="@color/xp_accent"
                android:textSize="11.5sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/xp_accent" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!--
                Your own standing, in the same shape the leaderboard screen
                uses for the "me" row - so arriving there from this card lands
                on something already recognisable.
            -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.7"
                android:background="@drawable/bg_row_card_me"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingTop="10dp"
                android:paddingEnd="11dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/leaderboardRank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono_bold"
                    android:text="@string/leaderboard_placeholder"
                    android:textColor="@color/text_soft"
                    android:textSize="11.5sp"
                    tools:text="#24" />

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_row_avatar_me">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_user_avatar"
                        app:tint="@color/brand_violet_light" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/jakarta_bold"
                    android:maxLines="1"
                    android:text="@string/leaderboard_you"
                    android:textColor="@color/white"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/leaderboardMyXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/mono_bold"
                    android:text="@string/leaderboard_placeholder"
                    android:textColor="@color/text_faint"
                    android:textSize="11.5sp"
                    tools:text="120 ★" />

            </LinearLayout>

            <!--
                The prize rule. It is what makes the rank beside it worth
                reading - a position with no stake attached is trivia.
            -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_summary_card"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_icon_violet">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_users"
                        app:tint="@color/xp_accent" />

                </FrameLayout>

                <TextView
                    android:id="@+id/leaderboardSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jakarta_semibold"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="2"
                    android:text="@string/leaderboard_subtitle_loading"
                    android:textColor="@color/text_dim"
                    android:textSize="10.5sp"
                    tools:text="Top 30 share 2,450 ★" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ================= Offers ================= -->
    <!--
        Labelled now that it is no longer the only thing on the screen. The
        heading is always shown, empty list included: "Offers / No offers
        right now" is a screen that has answered the question, whereas an
        unlabelled empty state under a leaderboard card reads as a screen that
        failed to load something.
    -->
    <TextView
        android:id="@+id/offerwallTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/jakarta_bold"
        android:text="@string/offerwall_section_title"
        android:textColor="@color/primary_text"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/offerwallList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_offerwall" />

        <ProgressBar
            android:id="@+id/offerwallLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />

        <LinearLayout
            android:id="@+id/offerwallEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offerwall_empty_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/offerwall_empty_body"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
