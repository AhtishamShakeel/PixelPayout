    <color name="offer_grad_end">#120E28</color>
    <color name="avatar_grad_start">#3A2F6B</color>
    <color name="avatar_grad_end">#1A1730</color>

    <!-- Secondary text ramp. The design uses .40-.75 white; these four cover
         it. `text_muted` above is .70 and is reused for the .65-.70 band. -->
