<?xml version="1.0" encoding="utf-8"?><!--
    Everything below the ladder: the "still loading" line that stands in for
    the rows, and the info note.

    The empty line lives here rather than in the header because it replaces
    the rows, and a row-replacement that sat above the heading would read as
    part of the hero card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Shown instead of the rows while the curve is still in flight, or
         if it never arrives. -->
    <TextView
        android:id="@+id/levelRewardsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/jakarta_medium"
        android:gravity="center"
        android:text="@string/level_rewards_loading"
        android:textColor="@color/text_ghost"
        android:textSize="12.5sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_info_note"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            app:tint="@color/brand_violet_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_medium"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/level_rewards_note"
            android:textColor="@color/text_faint"
            android:textSize="11.5sp" />

    </LinearLayout>

</LinearLayout>
