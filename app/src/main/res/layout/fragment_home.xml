                <TextView android:layout_width="0dp" android:layout_height="0dp" app:designX="120" app:designY="11" app:designW="580" app:designH="37" app:designTextSize="30" android:fontFamily="@font/jakarta_bold" android:includeFontPadding="false" android:gravity="center_vertical" android:textColor="@color/white" android:breakStrategy="simple" android:text="@string/home_today_bonus" app:designTextSp="16sp" />
