<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:background="#090D20" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="20dp">
    <com.example.pixelpayout.ui.home.HomeDesignLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:designWidth="946" app:designFlow="true">
        <!-- PENDING REDEMPTION: takes How it works' place at the top once the
             account has redeemed. One line that ellipsizes rather than wraps. -->
        <LinearLayout android:id="@+id/pendingRedeemRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:baselineAligned="false" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" android:visibility="gone" tools:visibility="visible" app:designX="0" app:designY="0" app:designW="946" app:designH="0" app:designGap="10dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_redeem" app:tint="@color/text_dim" />
            <TextView android:id="@+id/pendingRedeemValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/jakarta_semibold" android:maxLines="1" android:textColor="@color/white" android:textSize="13sp" tools:text="4 Pending Redeems · ready in 41h" />
        </LinearLayout>
        <!-- HOW IT WORKS: the approved reference's own illustration. -->
        <com.example.pixelpayout.ui.home.HomeReferenceArt android:layout_width="0dp" android:layout_height="0dp" app:designX="0" app:designY="14" app:designW="946" app:designH="149" android:tag="guide" android:importantForAccessibility="yes" android:contentDescription="@string/home_flow_description" android:id="@+id/earningGuide" app:designGap="10dp" />

        <!--
