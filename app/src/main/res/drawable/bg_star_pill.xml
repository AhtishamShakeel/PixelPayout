<?xml version="1.0" encoding="utf-8"?>
<!-- Header balance pill. 999px in the design; 100dp is past half the height
     of anything it wraps, so it reads as fully round. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/violet_tint_14" />
    <stroke android:width="1dp" android:color="@color/violet_tint_28" />
    <corners android:radius="100dp" />
</shape>
