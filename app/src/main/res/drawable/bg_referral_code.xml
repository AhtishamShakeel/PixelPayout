<?xml version="1.0" encoding="utf-8"?>
<!-- The user's own code on Profile. Dashed, because it is something to be
     copied out rather than a field to be typed into. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/violet_tint_14" />
    <stroke
        android:width="1dp"
        android:color="@color/violet_tint_35"
        android:dashWidth="5dp"
        android:dashGap="4dp" />
    <corners android:radius="14dp" />
</shape>
