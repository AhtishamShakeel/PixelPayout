<?xml version="1.0" encoding="utf-8"?>
<!-- Raised centre nav button: accent disc inside a 4dp ring of the bar colour,
     so it reads as lifted off the bar rather than punched through it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_dark" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
