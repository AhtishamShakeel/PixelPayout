<?xml version="1.0" encoding="utf-8"?>
<!-- One row on the board, and one prize band. Every row is its own card:
     the design separates them with a gap and a hairline rather than with
     dividers inside a single surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_card" />
    <stroke android:width="1dp" android:color="@color/stroke_subtle" />
    <corners android:radius="16dp" />
</shape>
