<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ... existing colors ... -->
    <!--
        THE app violet, and there is now only one.

        These were #8A8AFF and #5757FF - a second violet, a little lighter and
        bluer than brand_violet, reached by sixteen drawables and four layouts
        (the level badge, the nav centre, the bolt glyph, the quiz banner, the
        selected-answer state...) while everything drawn since used
        brand_violet. Two brand hues one step apart is the kind of thing that
        never looks broken in isolation and always looks slightly wrong when
        two screens sit side by side.

        Aliased rather than find-and-replaced across twenty files: the names
        read correctly where they are used, and the theme's colorPrimary
        genuinely is this.
    -->
    <item name="primary" type="color">@color/brand_violet</item>
    <item name="primary_dark" type="color">@color/brand_violet_deep</item>
    <color name="primary_transparent">#508A8AFF</color>
    <color name="gray">#808080</color>
    <color name="primary_text">#D5D5FF</color>
    <!-- Dark theme specific colors -->
    <!--
        The page background, moved from #121212 to the design's near-black.

        Changed in place rather than added alongside, because this token is
        also what the toolbar, the Play tab, the nav bar and the punch-out in
        bg_level_badge/circular_background paint themselves. Pointing only the
        theme at a new colour would leave every one of those a visibly
        lighter grey against the window - a seam at the top of each screen.

        Cards using card_dark (#2D2D2D) now sit on a darker page and so read
        with more contrast than before. That is the thing to look at on the
        screens not yet redrawn.
    -->
    <!--
        Not black. #08080D was a neutral near-black, and against it the violet
        chrome (nav, buttons, XP) read as the only coloured thing in the room.
        This carries a little of the brand hue in the ground itself, at a
        lightness that is still unmistakably a dark theme - the tint is meant
        to be felt rather than seen, and it should never be nameable as
        "purple" on a device.
    -->
    <color name="background_dark">#0A0814</color>
    <color name="surface_dark">#1E1E1E</color>
    <color name="card_dark">#2D2D2D</color>
    <color name="difficulty_easy">#4CAF50</color>
    <color name="difficulty_hard">#F44336</color>

    <color name="white">#FFFFFFFF</color>

    <!-- Semantic tokens. Prefer these over raw hex in layouts so a palette
         change is a one-file edit. Values below are the ones already in use,
         lifted out of the layouts rather than invented. -->
    <color name="text_secondary">#B1B1B1</color>
    <color name="track_dark">#3A3A3A</color>
    <color name="card_stroke">#4A4A4A</color>
    <color name="nav_bar_stroke">#2A2A2A</color>

    <!-- ==================================================================
         Home design (handoff 1a) palette.

         Additive: nothing above changes meaning. New home-screen surfaces
         use these; older screens keep card_dark/surface_dark until they are
         redrawn, so the two sets coexist on purpose rather than by neglect.

         Alpha-over-white/black values are written as #AARRGGBB - the design
         specifies them as rgba() and the conversion is easy to get wrong by
         hand, so it is done once here and never repeated in a layout.
         ================================================================== -->

    <!-- Surfaces -->
    <!-- The ONE card ground, shared by every card on Home and by the wallet
         and games screens. Lifted with the page beneath it so the step
         between them stays the same, and tinted to match it - a neutral card
         on a violet-tinted page reads as a grey patch. -->
    <color name="surface_card">#15131F</color>

    <!-- Hairline borders. The design uses these instead of shadows, so they
         are the only thing separating a card from the page - do not drop
         them when reusing these backgrounds. -->
    <color name="stroke_subtle">#0FFFFFFF</color>
    <color name="stroke_card">#12FFFFFF</color>
    <color name="stroke_strong">#1FFFFFFF</color>

    <!-- Violet. `primary`/`primary_dark` (#8A8AFF/#5757FF) are already the
         balance-gradient stops, so they are reused there rather than
         duplicated under new names. -->
    <color name="brand_violet">#7C5CFF</color>
    <color name="brand_violet_light">#A48CFF</color>
    <color name="brand_violet_deep">#4A2FC9</color>
    <color name="balance_grad_end">#3A3AA8</color>
    <color name="violet_tint_14">#247C5CFF</color>
    <color name="violet_tint_20">#337C5CFF</color>
    <color name="violet_tint_25">#407C5CFF</color>
    <color name="violet_tint_28">#477C5CFF</color>

    <!-- Gold. Distinct from the existing star_gold/quiz_gold, which are
         warmer and belong to the old screens. -->
    <color name="gold">#FFD24A</color>
    <color name="gold_deep">#FFA82A</color>
    <color name="gold_tint_16">#29FFD24A</color>
    <color name="gold_stroke">#2EFFD24A</color>
    <!-- Text sitting ON gold, where white would be unreadable. -->
    <color name="on_gold">#2B1A00</color>

    <!-- Boost blue -->
    <color name="boost_blue">#4A9EFF</color>
    <color name="boost_blue_light">#6CB2FF</color>
    <color name="boost_stroke">#384A9EFF</color>

    <!-- Completed states -->
    <color name="success">#4ADE80</color>

    <!-- Gradient stops that are not part of a wider ramp -->
    <color name="offer_grad_start">#1C1440</color>
    <color name="offer_grad_end">#120E28</color>
    <color name="avatar_grad_start">#3A2F6B</color>
    <color name="avatar_grad_end">#1A1730</color>

    <!-- Secondary text ramp. The design uses .40-.75 white; with text_strong
         through text_trace further down, these cover it. -->
    <color name="text_dim">#BFFFFFFF</color>
    <color name="text_faint">#73FFFFFF</color>
    <color name="text_ghost">#66FFFFFF</color>

    <!-- Progress tracks: one for bars sitting on the white-ish balance card,
         one for bars on a dark card. -->
    <color name="track_on_light">#38FFFFFF</color>
    <color name="track_on_dark">#14FFFFFF</color>
    <!-- ==================================================================
         Weekly leaderboard (handoff: leaderboard redesign).

         Additive, like the home palette above. The place colours are the only
         hues on the screen that are not violet or gold - they are the medal
         metals, and they carry the podium without a single image.
         ================================================================== -->
    <color name="silver">#C6CBD8</color>
    <color name="bronze">#E0965A</color>
    <!-- The podium avatar well: a shade lighter than surface_card so the ring
         reads as a ring rather than as the edge of the page. -->
    <color name="surface_podium">#15151F</color>
    <!-- Text sitting ON a gold/silver/bronze badge. -->
    <color name="on_podium_badge">#0D0D12</color>
    <!-- The pinned "your rank" card. Deeper than offer_grad_* so the card
         holds its own against the page it floats over. -->
    <color name="rank_card_start">#241C52</color>
    <color name="rank_card_end">#151033</color>

    <!-- Violet tints the home palette did not need. -->
    <color name="violet_tint_16">#297C5CFF</color>
    <color name="violet_tint_30">#4D7C5CFF</color>
    <color name="violet_tint_35">#597C5CFF</color>
    <color name="violet_tint_50">#807C5CFF</color>
    <color name="violet_light_60">#99A48CFF</color>
    <color name="brand_violet_pressed">#8E72FF</color>

    <!-- Gold at the two weights the prize-zone rule uses. -->
    <color name="gold_dash">#73FFD24A</color>
    <color name="gold_label">#B3FFD24A</color>

    <!-- The rest of the white ramp. text_dim (.75), text_faint (.45) and
         text_ghost (.40) already cover the middle; these are the ends. -->
    <color name="text_strong">#E6FFFFFF</color>
    <color name="text_soft">#D9FFFFFF</color>
    <color name="text_half">#80FFFFFF</color>
    <color name="text_wisp">#59FFFFFF</color>
    <color name="text_trace">#47FFFFFF</color>
    <color name="stroke_avatar">#1AFFFFFF</color>

    <!-- ==================================================================
         Wallet (gaming-wallet handoff).

         The handoff ships its own "Nocturne" palette - a blue-grey ground
         (#161826) with a #9184d9 blurple accent. It is NOT used: the brief
         was to take the design's STRUCTURE and paint it in the palette this
         app already has, so every value below resolves to an existing token.
         The mapping, for anyone comparing the two side by side:

           Nocturne #161826 ground     -> background_dark
           Nocturne #232532 card       -> surface_card
           Nocturne #3f424d border     -> stroke_card / stroke_strong
           Nocturne #9184d9 accent     -> brand_violet
           Nocturne #b5abfc accent-400 -> brand_violet_light
           Nocturne #9397ab neutral    -> text_faint
           Nocturne #75798c neutral    -> text_ghost

         The one deliberate departure: the design tints its star glyph with
         the accent, and ours stays `gold`. A star means the same thing on
         every other screen in this app, and it is not violet on any of them.
         ================================================================== -->

    <!-- The bottom sheet floats above the page, so it is a step lighter than
         surface_card rather than the same value - otherwise the sheet and the
         cards showing through the scrim read as one surface. -->
    <color name="surface_sheet">#14141E</color>
    <!-- Input wells sit INSIDE the sheet, so they go darker, not lighter. -->
    <color name="surface_field">#0B0B12</color>

    <!-- Order tracker + status tags. Pending is gold because that is what a
         pending payout already looks like everywhere else in this app. -->
    <color name="status_pending_fill">#29FFD24A</color>
    <color name="status_done_fill">#1F4ADE80</color>
    <color name="status_done_stroke">#4D4ADE80</color>

    <!-- ==================================================================
         Play > Games (Games.dc.html handoff).

         Same Nocturne system as the Wallet handoff above, so the same
         mapping applies and no hex is copied out of it. Only the values
         Nocturne uses here that had no token yet are added:

           Nocturne #232532 row              -> surface_row
           Nocturne rgba(145,132,217,.45)    -> pip_remaining
           Nocturne #3f424d spent pip        -> pip_spent

         One deliberate departure: the handoff puts a Stars balance in the
         header and a "5-30 Stars" pill on every game row. Both are dropped.
         Games are an XP-only source - claimReward awards no points for a
         GAME event - so a Stars figure on this screen would be promising a
         payout the server never makes. The XP pill stands alone.
         ================================================================== -->

    <!-- A game row sits ON the page beside the counter panel, so it is a step
         lighter than surface_card rather than equal to it. -->
    <color name="surface_row">#17171F</color>
    <color name="pip_remaining">#737C5CFF</color>
    <color name="pip_spent">#2A2A33</color>

    <!-- ==================================================================
         SEMANTIC LAYER - what a colour MEANS, not what it looks like.

         Everything above this line is the palette: raw hues, named after
         themselves. Everything below is the vocabulary layouts are meant to
         speak. The rule is one sentence:

             a layout names a MEANING; only this file names a HUE.

         The reason is not tidiness. Before this block, the star glyph was
         tinted four different ways across the app - `gold` in the wallet,
         `brand_violet_light` on Home, `brand_violet` on Profile, and
         `text_faint` in the activity row - and the Home stat cards had the
         two currencies exactly inverted, Stars painted violet and XP gold.
         None of that was a decision; each screen reached for a hue that
         looked right on its own. A token called `gold` invites that. A token
         called `stars_accent` does not: painting XP with it is visibly wrong
         at the point of writing, not three screens later.

         The two currencies:

             Stars - the premium currency, the thing that is redeemed for
                     something real. GOLD, wherever a Star balance, cost,
                     reward or payout appears. Never decorative.
             XP    - the progress currency, earned constantly, spent never.
                     VIOLET, the brand family.

         XP sharing the brand hue is deliberate, and the ambiguity it invites
         is resolved by WEIGHT rather than by a fifth hue: XP surfaces go
         violet TINTED, and the glyph does the rest - a bolt is XP, a star is
         Stars.

         One exception, which is a rule rather than a let-off: INSIDE A
         CURRENCY CARD, THE CURRENCY OWNS THE PRIMARY ACTION. The Stars card's
         redeem button is gold, the XP card's is violet. Violet-on-gold was
         tried first and failed - the brand violet sits near the complement of
         the Stars card's warm ground, so the button read as pasted onto the
         card rather than part of it. Anywhere off those two cards - nav,
         sheets, dialogs, generic CTAs - violet is still the action colour.
         ================================================================== -->

    <!-- Stars. -->
    <item name="stars_accent_dash" type="color">@color/gold_dash</item>
    <item name="stars_accent" type="color">@color/gold</item>
    <item name="stars_accent_deep" type="color">@color/gold_deep</item>
    <!-- Star-coloured text that must recede - a unit label beside a figure,
         a caption under it - without dropping to plain grey. -->
    <item name="stars_accent_soft" type="color">@color/gold_label</item>
    <item name="stars_tint" type="color">@color/gold_tint_16</item>
    <item name="stars_stroke" type="color">@color/gold_stroke</item>
    <!-- For the rare case of text sitting ON a solid Stars fill. -->
    <item name="on_stars" type="color">@color/on_gold</item>

    <!-- First place. Gold, and NOT stars_accent, even though it resolves to
         the same hex today: a medal and a currency are different facts that
         happen to share a colour, and the leaderboard shows both at once -
         a gold "1" beside a gold prize figure. Naming them apart is what
         lets one of them be repainted later without hunting for which golds
         on that screen meant money. Silver and bronze sit beside it. -->
    <item name="podium_gold" type="color">@color/gold</item>

    <!-- Home's cards share ONE ground, `surface_card`, and say which
         currency they are about with their BORDER. There is deliberately no
         `stars_surface`/`xp_surface` pair: a tinted ground per card is what
         produced the olive cards the accent tints mixed to, and left the
         screen with no neutral to rest on. Accent belongs in the hairline,
         the glyph and the figure - not under them. -->

    <!-- XP. -->
    <item name="xp_accent" type="color">@color/brand_violet_light</item>
    <item name="xp_accent_deep" type="color">@color/brand_violet</item>
    <item name="xp_tint" type="color">@color/violet_tint_20</item>
    <item name="xp_stroke" type="color">@color/violet_tint_35</item>
</resources>
