<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        The advertising ID, KEPT.

        This was previously removed with tools:node="remove", which quietly
        broke the two things this app makes its money from. Without the ad ID
        AdMob can only serve non-personalised ads - materially lower eCPM on
        every impression - and every offerwall loses the identifier it
        attributes completions with, so offers can be finished and never
        credited. It is also how Tapjoy and the rest match a test device, so
        integration testing fails in a way that looks like a broken SDK.

        Declaring it carries an obligation: the Play Data Safety form must
        say the advertising ID is collected and used for advertising. That is
        the ordinary declaration for an ad-supported app.

        It must NOT be reinstated if this app ever targets children under
        Play Families policy - the ad ID is prohibited there. That is not the
        case today: the audience is teenage and adult gamers and the app runs
        rewarded ads against a real-value economy.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name="com.pixelpayout.PixelPayoutApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelPayout"
        android:configChanges="orientation|keyboardHidden|screenSize"
        tools:targetApi="31">
        <activity
            android:name="com.example.pixelpayout.ui.auth.Auth"
            android:exported="false" />

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <activity
            android:name="com.example.pixelpayout.ui.onboarding.OnboardingActivity"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.pixelpayout.ui.main.MainActivity" />
        <activity
            android:name="com.example.pixelpayout.ui.legal.LegalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PixelPayout" />
        <activity
            android:name="com.example.pixelpayout.ui.quiz.QuizActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.example.pixelpayout.ui.game.GamePlayActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PixelPayout"
            tools:ignore="MissingClass" />

        <!--
            The offerwall WebView host.

            adjustResize because walls carry survey and sign-up forms, and
            without it the keyboard covers the field being typed into - the
            single most common way a hosted wall becomes unusable on a small
            screen.
        -->
        <activity
            android:name="com.example.pixelpayout.ui.rewards.OfferwallActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PixelPayout"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="MissingClass" />


        <activity
            android:name="com.tapjoy.TJAdUnitActivity"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/TranslucentTheme"
            android:hardwareAccelerated="true"
            tools:ignore="UnusedAttribute" />

        <activity
            android:name="com.tapjoy.TJWebViewActivity"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/TranslucentTheme"
            android:hardwareAccelerated="true"
            tools:ignore="UnusedAttribute" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id"
            tools:replace="android:value" />
    </application>

</manifest>
