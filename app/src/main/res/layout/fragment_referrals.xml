<?xml version="1.0" encoding="utf-8"?><!--
    Referrals, opened from the referrals row on Profile: the invited /
    qualified / paid funnel, and every invitee's progress toward the unlock.

    Referral progress measures XP toward the unlock threshold, not level.
    That is the condition readReferrerForUnlock actually tests, so a bar
    measuring anything else would fill at a different rate than the reward
    arrives.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="12dp"
        android:paddingEnd="17dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/referralsBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/leaderboard_back"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_dim" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_semibold"
                android:letterSpacing="-0.01"
                android:text="@string/referrals_title"
                android:textColor="@color/text_strong"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/funnelInvited"
                layout="@layout/item_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/funnelQualified"
                layout="@layout/item_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/funnelPaid"
                layout="@layout/item_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_semibold"
                android:text="@string/profile_referral_progress"
                android:textColor="@color/text_strong"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/profileEarnedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_medium"
                android:textColor="@color/text_ghost"
                android:textSize="11.5sp"
                tools:text="200 ★ earned" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inviteesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_invitee" />

        <LinearLayout
            android:id="@+id/inviteesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code_tile"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="22dp"
            android:paddingBottom="22dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_users"
                app:tint="@color/brand_violet_deep" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/profile_no_invites"
                android:textColor="@color/text_faint"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/profile_no_invites_sub"
                android:textColor="@color/text_ghost"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
