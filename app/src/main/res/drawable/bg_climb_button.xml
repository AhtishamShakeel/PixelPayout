<?xml version="1.0" encoding="utf-8"?>
<!-- The only tappable thing on the pinned card, so it is also the only
     surface on this screen with a pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_violet_pressed" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_violet" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
