<?xml version="1.0" encoding="utf-8"?>
<!-- The outlined action beside or under a primary one on Home: Change,
     View levels. Same height as the filled button, less weight. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#211B4A" />
            <stroke android:width="1dp" android:color="#6D5FC4" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
