<?xml version="1.0" encoding="utf-8"?><!--
    The confirmation shown before a rewarded ad, shared by every claim that is
    gated on one - the daily streak and the daily goal set today.

    A hand-built layout rather than MaterialAlertDialogBuilder's default: that
    one paints itself from colorSurface (#1E1E1E, the old palette) with the
    platform's own typography, so it landed on top of the redrawn home screen
    looking like a different app - pale grey, wrong font, wrong radius.

    Shown through CustomDialogTheme, whose window background is transparent, so
    the rounded card below is the whole visible dialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_level_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:id="@+id/adClaimDot"
            android:background="@drawable/bg_dot_streak" />

        <TextView
            android:id="@+id/adClaimTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_bold"
            android:textColor="@color/white"
            android:textSize="17sp"
            tools:text="Day 4 reward" />

    </LinearLayout>

    <!--
        The figure is the point of the dialog, so it is the largest thing in
        it rather than a number buried in a sentence.
    -->
    <TextView
        android:id="@+id/adClaimReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/mono_bold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.03"
        android:textColor="@color/gold"
        android:textSize="30sp"
        tools:text="+10 ★" />

    <TextView
        android:id="@+id/adClaimMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/jakarta_medium"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/text_faint"
        android:textSize="13sp"
        tools:text="Watch a short ad to claim it." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adClaimCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="@string/streak_dialog_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_faint"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adClaimWatch"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/jakarta_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="@string/streak_dialog_watch"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/brand_violet"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
