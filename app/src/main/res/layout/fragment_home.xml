                    <com.example.pixelpayout.ui.home.HomeReferenceArt android:layout_width="0dp" android:layout_height="0dp" app:designX="0" app:designY="0" app:designW="312" app:designH="184" android:tag="games_background" android:importantForAccessibility="no" />
                    <View android:layout_width="0dp" android:layout_height="0dp" app:designX="12" app:designY="139" app:designW="234" app:designH="39" android:tag="reference_xp_chip" android:importantForAccessibility="no" />
                    <TextView style="@style/HomeEarnTileTitle" android:text="@string/home_games" />
