<?xml version="1.0" encoding="utf-8"?><!--
    The gold counterpart to progress_violet: same near-black track, same
    99dp caps, so the XP bar and the stars bar beside it differ only in hue.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_on_dark" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/stars_accent_deep"
                    android:endColor="@color/stars_accent" />
                <corners android:radius="99dp" />
            </shape>
        </clip>
    </item>
</layer-list>
