<?xml version="1.0" encoding="utf-8"?>
<!-- The XP pill on a game row. The handoff pairs it with a Stars pill; ours
     stands alone, because games pay XP and nothing else. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/violet_tint_14" />
    <stroke android:width="1dp" android:color="@color/brand_violet_deep" />
    <corners android:radius="4dp" />
</shape>
