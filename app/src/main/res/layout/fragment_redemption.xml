<?xml version="1.0" encoding="utf-8"?><!--
    Wallet, rebuilt on the gaming-wallet handoff.

    Two views live in this one file, switched by the segmented control:

      * WALLET - balance, anything already on its way, the first-redeem
        offer, the game grid, and recent activity.
      * ORDERS - every redemption this account has placed, with a tracker.

    They are one fragment rather than two because the handoff makes them one
    screen with a toggle, and because both are driven entirely by the same
    `redemptions` snapshot - splitting them would mean two listeners that can
    disagree about what is outstanding.

    The referral card that used to open this screen is on Profile now.

    The bottom nav in the handoff is NOT rebuilt here: this app already has
    PixelBottomNav in the activity, and the design's bar is the same five
    tabs. Drawing a second one inside the fragment would put two nav bars on
    screen at once.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!--
        No header. The activity toolbar already names the app and the tab, so
        the "PIXELPAYOUT / Wallet" block here was the same words a second
        time. The icon buttons it carried went with it: Orders is reached by
        the segmented control and by the button on the balance card, both of
        which were already there, and neither needed a third way in.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/walletScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="11dp"
            android:paddingEnd="17dp"
            android:paddingBottom="24dp">

            <!-- ================= Wallet / Orders switch ================= -->
            <!--
                Present in both views. The handoff only shows it on Orders,
                reaching it from the header clock - but a control that appears
                only after you have already navigated cannot be found by
                anyone who has not navigated, so it stays put.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_segment_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/segmentWallet"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_on"
                    android:fontFamily="@font/jakarta_semibold"
                    android:gravity="center"
                    android:text="@string/nav_wallet"
                    android:textColor="@color/brand_violet_light"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/segmentOrders"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jakarta_medium"
                    android:gravity="center"
                    android:text="@string/wallet_orders"
                    android:textColor="@color/text_faint"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <!-- ============================================================
                 WALLET VIEW
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/walletView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ================= Your stars ================= -->
                <!--
                    A dark surface with the accent as a glow, not the violet
                    flood Home uses. Both the handoff and its design system
                    are explicit that the accent is a line and a glow rather
                    than a fill, and it keeps Wallet from reading as a second
                    copy of Home.

                    REBUILT AROUND THE NEXT THING THE BALANCE CAN BUY. It used
                    to print the balance and a sentence about it, with two
                    buttons underneath. The sentence was doing the work of a
                    progress bar in prose, and "Orders" was a second route to
                    a tab that is already the other half of the control at the
                    top of this screen. What is left is the figure, the target,
                    the bar between them, and one button.

                    The micro-column reading PLAY / COMPLETE / EARN / REDEEM
                    from the mockup is deliberately not here. It describes the
                    app to somebody already inside it, in four words none of
                    which is an instruction.

                    The hero artwork is walletHeroArt, hidden until a URL is
                    set on the catalogue - see RedemptionFragment. The card is
                    laid out so the text column keeps its full width whether or
                    not the art ever arrives.
                -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_wallet_balance"
                    android:clipToOutline="true">

                    <View
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-70dp"
                        android:layout_marginEnd="-50dp"
                        android:background="@drawable/bg_glow_violet" />

                    <!--
                        Behind the text rather than beside it, bottom-right and
                        bleeding off the card edge. A column of its own would
                        squeeze the figure and the bar on a narrow phone, and
                        this way a missing image costs the layout nothing.
                    -->
                    <ImageView
                        android:id="@+id/walletHeroArt"
                        android:layout_width="150dp"
                        android:layout_height="130dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star"
                                app:tint="@color/stars_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/jakarta_semibold"
                                android:letterSpacing="0.14"
                                android:text="@string/wallet_stars_label"
                                android:textAllCaps="true"
                                android:textColor="@color/text_faint"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:baselineAligned="false"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/walletBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jakarta_extrabold"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.035"
                                android:text="@string/wallet_balance_placeholder"
                                android:textColor="@color/text_strong"
                                android:textSize="42sp"
                                tools:text="14,820" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="7dp"
                                android:layout_marginBottom="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star"
                                app:tint="@color/stars_accent" />

                        </LinearLayout>

                        <!--
                            What the balance is climbing toward, and how far
                            along it is. Named from a real pack rather than
                            from a points-to-currency rate: a pack carries a
                            price and a free-text amount with nothing
                            machine-readable between them, so an invented rate
                            would be wrong the first time anything was
                            repriced.

                            The whole group hides once every pack is already
                            affordable - see renderReach - because a full bar
                            with nothing above it is progress toward nothing.
                        -->
                        <TextView
                            android:id="@+id/walletReachLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/jakarta_medium"
                            android:maxLines="1"
                            android:textColor="@color/text_dim"
                            android:textSize="12.5sp"
                            tools:text="600 more stars for 30 UC" />

                        <LinearLayout
                            android:id="@+id/walletReachGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ProgressBar
                                android:id="@+id/walletReachBar"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="7dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/progress_gold"
                                tools:progress="35" />

                            <TextView
                                android:id="@+id/walletReachRatio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/mono_medium"
                                android:textColor="@color/text_ghost"
                                android:textSize="11sp"
                                tools:text="0 / 600" />

                        </LinearLayout>

                        <!--
                            Earn, not Play. This card counts stars, and Play
                            pays XP - sending somebody who wants a bigger
                            balance to the screen that grows the other
                            currency is the wrong half of the app.

                            Orders has gone from here: the segmented control at
                            the top of this screen is the way to Orders, and a
                            card-level shortcut was a second door to the same
                            room.
                        -->
                        <TextView
                            android:id="@+id/walletEarnMore"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_button_stars_outline"
                            android:clickable="true"
                            android:drawablePadding="7dp"
                            android:focusable="true"
                            android:fontFamily="@font/jakarta_bold"
                            android:gravity="center"
                            android:minWidth="150dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="@string/wallet_earn_stars"
                            android:textColor="@color/stars_accent"
                            android:textSize="13sp"
                            app:drawableEndCompat="@drawable/ic_arrow_right"
                            app:drawableTint="@color/stars_accent" />

                    </LinearLayout>

                </FrameLayout>

                <!-- ================= Pending ================= -->
                <LinearLayout
                    android:id="@+id/walletPendingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_pending_banner"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_loader"
                        app:tint="@color/brand_violet_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/walletPendingTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_semibold"
                            android:textColor="@color/text_strong"
                            android:textSize="13sp"
                            tools:text="1 order processing" />

                        <TextView
                            android:id="@+id/walletPendingMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/jakarta_medium"
                            android:maxLines="1"
                            android:textColor="@color/text_faint"
                            android:textSize="11.5sp"
                            tools:text="325 UC" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_caret_right"
                        app:tint="@color/text_ghost" />

                </LinearLayout>

                <!-- ================= First-redeem offer ================= -->
                <!--
                    Shown while the discount is unspent and some pack actually
                    carries a discounted price. Nothing else gates it.

                    THE LEVEL LOCK IS GONE, and with it the row that used to
                    read "Unlocks at level 10". This offer exists to prove the
                    payout is real, which is worth most to somebody who has not
                    decided whether to believe us yet and least to somebody who
                    has already stayed ten levels. Holding it back until then
                    inverted its own purpose. The server dropped the gate too -
                    see validateRedemption - so there is no level to name here
                    and no disabled state to draw.

                    Once it is finished it is finished FOREVER: spent, or
                    refused because the game account had already had one. See
                    MainViewModel.firstRedeemFinished.

                    The gift artwork is firstRedeemArt, hidden until a URL is
                    set on config/wallet - see RedemptionFragment.
                -->
                <FrameLayout
                    android:id="@+id/firstRedeemCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_first_redeem_card"
                    android:clipToOutline="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/firstRedeemArt"
                        android:layout_width="132dp"
                        android:layout_height="118dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="-4dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!--
                            A pill, not a row. The old header put a kicker on
                            the left and a "One time only" chip on the right,
                            which said the same thing twice at opposite ends of
                            the card.
                        -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_violet"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_gift"
                                app:tint="@color/brand_violet_light" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/jakarta_semibold"
                                android:letterSpacing="0.1"
                                android:text="@string/first_redeem_kicker"
                                android:textAllCaps="true"
                                android:textColor="@color/brand_violet_light"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/jakarta_extrabold"
                            android:letterSpacing="-0.02"
                            android:text="@string/first_redeem_title"
                            android:textColor="@color/white"
                            android:textSize="19sp" />

                        <!--
                            Kept clear of the artwork on the right. The body is
                            one short line by design; anything longer would run
                            under the gift.
                        -->
                        <TextView
                            android:id="@+id/firstRedeemBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="120dp"
                            android:fontFamily="@font/jakarta_medium"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/first_redeem_body"
                            android:textColor="@color/text_faint"
                            android:textSize="12.5sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shield_check"
                                app:tint="@color/brand_violet" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:fontFamily="@font/jakarta_medium"
                                android:text="@string/first_redeem_uid_note"
                                android:textColor="@color/text_ghost"
                                android:textSize="11.5sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/firstRedeemButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_button_accent_outline"
                            android:drawablePadding="7dp"
                            android:fontFamily="@font/jakarta_bold"
                            android:gravity="center"
                            android:text="@string/first_redeem_cta"
                            android:textColor="@color/brand_violet_light"
                            android:textSize="13.5sp"
                            app:drawableStartCompat="@drawable/ic_gift"
                            app:drawableTint="@color/brand_violet_light" />

                    </LinearLayout>

                </FrameLayout>

                <!-- ================= Choose your reward ================= -->
                <!--
                    The count beside the title is gone. "4 games" was a fact
                    about our catalogue rather than an instruction to the
                    reader, and it sat where the mockup puts the one line that
                    tells them what to do with the grid below.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_extrabold"
                        android:letterSpacing="-0.02"
                        android:text="@string/wallet_redeem_title"
                        android:textColor="@color/white"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/walletGamesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/jakarta_medium"
                        android:maxLines="1"
                        android:text="@string/wallet_redeem_hint"
                        android:textColor="@color/text_ghost"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gamesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_redemption_game" />

                <TextView
                    android:id="@+id/walletEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:gravity="center"
                    android:text="@string/wallet_no_rewards"
                    android:textColor="@color/text_faint"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <!-- ================= Activity ================= -->
                <LinearLayout
                    android:id="@+id/activityHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="4dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_semibold"
                        android:text="@string/wallet_activity_title"
                        android:textColor="@color/text_strong"
                        android:textSize="15sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/activityRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_activity" />

                <TextView
                    android:id="@+id/activityEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:gravity="center"
                    android:text="@string/wallet_no_activity"
                    android:textColor="@color/text_faint"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:visibility="gone" />

            </LinearLayout>

            <!-- ============================================================
                 ORDERS VIEW
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/ordersView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ordersRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_order" />

                <TextView
                    android:id="@+id/ordersEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:gravity="center"
                    android:text="@string/wallet_no_orders"
                    android:textColor="@color/text_faint"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_violet"
        app:indicatorSize="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackThickness="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
