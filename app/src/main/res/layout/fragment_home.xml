                <TextView android:id="@+id/levelBadgeNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/jakarta_extrabold" android:includeFontPadding="false" android:shadowColor="#7D4FC9" android:shadowDy="2" android:shadowRadius="2" android:textColor="@color/white" android:textSize="20sp" tools:text="2" />
