<?xml version="1.0" encoding="utf-8"?><!--
    The redeem action inside the Stars card. The one filled button in the
    pair: cashing out is the thing the screen is ultimately for, and it is
    the only place the violet is allowed to go solid.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_violet_pressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_violet" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
