<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in behind the avatar image, and what shows through if the user
     has no photo. CSS 140deg -> 315. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:startColor="@color/avatar_grad_start"
        android:endColor="@color/avatar_grad_end"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/stroke_strong" />
</shape>
