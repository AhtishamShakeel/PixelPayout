<?xml version="1.0" encoding="utf-8"?>
<!--
    The leader rule between a label and its value. Needs
    android:layerType="software" on the view, or the dashes are lost to
    hardware acceleration and it draws as a solid line.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="line">
    <stroke
        android:width="1dp"
        android:color="@color/hairline_soft"
        android:dashWidth="2dp"
        android:dashGap="4dp" />
</shape>
