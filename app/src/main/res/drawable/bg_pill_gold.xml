<?xml version="1.0" encoding="utf-8"?>
<!-- The prize pill under a podium place. Bordered, unlike the plain icon chips,
     because it sits on the page rather than inside a card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/stars_tint" />
    <stroke android:width="1dp" android:color="@color/stars_stroke" />
    <corners android:radius="100dp" />
</shape>
