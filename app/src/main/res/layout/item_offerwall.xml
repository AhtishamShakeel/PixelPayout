<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:minHeight="170dp"
    android:background="@drawable/bg_earn_hero" android:foreground="?attr/selectableItemBackground"
    android:clickable="true" android:focusable="true">
    <ImageView android:layout_width="0dp" android:layout_height="0dp"
        android:importantForAccessibility="no" android:src="@drawable/earn_offers_art"
        android:scaleType="fitCenter"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="0dp" android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintWidth_percent="0.58"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/offerwallName" style="@style/EarnLabel"
            android:background="@drawable/bg_earn_chip" android:paddingStart="11dp" android:paddingEnd="11dp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="12sp" tools:text="Tapjoy" />
        <TextView style="@style/EarnLabel" android:layout_width="match_parent"
            android:layout_marginTop="6dp" android:text="@string/earn_offer_title"
            android:fontFamily="@font/jakarta_bold" android:textSize="22sp" android:letterSpacing="-0.04" />
        <TextView android:id="@+id/offerwallSubtitle" style="@style/EarnBody"
            android:layout_width="match_parent" android:layout_marginTop="5dp" android:textSize="12sp"
            tools:text="Complete offers to earn stars" />
        <TextView android:id="@+id/exploreOffers" style="@style/EarnButton"
            android:layout_width="match_parent" android:layout_marginTop="10dp"
            android:textSize="13sp" android:text="@string/earn_explore_offers"
            android:drawableEnd="@drawable/ic_earn_arrow" android:drawableTint="@color/white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
