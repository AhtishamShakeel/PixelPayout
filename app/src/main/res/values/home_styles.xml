<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Three equal-width tiles with room for artwork, a two-line title and
         a larger reward chip. Keep a readable height even on compact phones. -->
    <dimen name="home_tile_gap">8dp</dimen>

    <style name="HomeEarnTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:importantForAccessibility">yes</item>
        <item name="designWidth">312</item>
        <item name="designHeight">320</item>
        <item name="android:minHeight">124dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- The tile's name. Positions and sizes are the reference's; the text
         shrinks to fit its box. -->
    <style name="HomeEarnTileTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="designX">18</item>
        <item name="designY">146</item>
        <item name="designW">276</item>
        <item name="designH">86</item>
        <item name="designTextSp">14sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">bottom</item>
        <item name="android:maxLines">2</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- The "Earn XP" / "Earn stars" chip label, beside its icon. -->
    <style name="HomeEarnTileChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="designX">62</item>
        <item name="designY">248</item>
        <item name="designW">178</item>
        <item name="designH">48</item>
        <item name="designTextSp">11sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="HomeEarnTileArrow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="designX">256</item>
        <item name="designY">250</item>
        <item name="designW">46</item>
        <item name="designH">44</item>
        <item name="android:src">@drawable/ic_games_arrow</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">3dp</item>
        <item name="android:tag">reference_arrow</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/white</item>
    </style>
</resources>
