<?xml version="1.0" encoding="utf-8"?>
<!-- A medalled row on the standings. Same card, same height and same radius
     as every other place - only the tint and the hairline change, which is
     what lets the first three read as the top of one list rather than as a
     separate exhibit above it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/silver_tint_16" />
    <stroke android:width="1dp" android:color="@color/silver_stroke" />
    <corners android:radius="16dp" />
</shape>
