                    <ImageView android:layout_width="0dp" android:layout_height="0dp" app:designX="16" app:designY="146" app:designW="29" app:designH="25" android:src="@drawable/ic_star_gold" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <ImageView style="@style/HomeEarnTileArrow" />
                </com.example.pixelpayout.ui.home.HomeDesignLayout>
            </LinearLayout>
        </LinearLayout>
        <com.example.pixelpayout.ui.home.HomeDesignLayout android:layout_width="0dp" android:layout_height="0dp" app:designX="0" app:designY="16" app:designW="946" app:designH="0" app:designWidth="946" app:designHeight="267" android:tag="reference_panel" android:visibility="gone" android:id="@+id/goalsCard" app:designGap="12dp" android:minHeight="190dp">
            <com.example.pixelpayout.ui.home.HomeDesignLayout android:layout_width="0dp" android:layout_height="0dp" app:designX="0" app:designY="8" app:designW="946" app:designH="77" app:designWidth="946" app:designHeight="77" android:id="@+id/goalsHeader">
