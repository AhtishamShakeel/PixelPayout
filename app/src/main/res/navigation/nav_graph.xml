<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.pixelpayout.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_details"
            app:destination="@id/detailsFragment" />
    </fragment>

    <!--
        Play hosts Games and Quizzes as tabs. startTab picks which one opens,
        so the quiz row on Home can still land the user straight on quizzes.
    -->
    <fragment
        android:id="@+id/navigation_play"
        android:name="com.example.pixelpayout.ui.play.PlayFragment"
        android:label="Play">
        <argument
            android:name="startTab"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/navigation_rewards"
        android:name="com.example.pixelpayout.ui.rewards.RewardsFragment"
        android:label="Rewards" />

    <!--
        A pushed destination, not a tab: it is opened from the level card on
        Home and popped straight back off, the same shape as the leaderboard.
    -->
    <fragment
        android:id="@+id/levelRewardsFragment"
        android:name="com.example.pixelpayout.ui.rewards.LevelRewardsFragment"
        android:label="Level rewards" />

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.example.pixelpayout.ui.leaderboard.LeaderboardFragment"
        android:label="Leaderboard" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.pixelpayout.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/navigation_redemption"
        android:name="com.example.pixelpayout.ui.redemption.RedemptionFragment"
        android:label="Cashout" />

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.pixelpayout.ui.details.DetailsFragment"
        android:label="Details">
        <argument
            android:name="type"
            app:argType="string" />
    </fragment>

</navigation>