                    <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="0dp" android:layout_height="0dp" app:designX="24" app:designY="6" app:designW="104" app:designH="44" android:indeterminate="false" android:max="100" app:indicatorSize="20dp" app:indicatorInset="0dp" app:trackThickness="1dp" app:trackColor="#30304F" app:indicatorColor="#A76EFF" android:importantForAccessibility="no" android:id="@+id/goalRing1" />
                    <com.example.pixelpayout.ui.home.HomeReferenceArt android:layout_width="0dp" android:layout_height="0dp" app:designX="34" app:designY="10" app:designW="84" app:designH="36" android:tag="goal_game" android:importantForAccessibility="no" android:id="@+id/goalImage1" />
