<?xml version="1.0" encoding="utf-8"?><!--
    The logo screen StartupLoader holds over MainActivity while the first
    screens load. Same ground as the system splash before it, so the hand-off
    from one to the other is not seen. Clickable, so nothing underneath can be
    tapped through it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clickable="true"
    android:elevation="40dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_foreground" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/startupProgress"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:indicatorColor="@color/brand_violet_light"
            app:trackColor="@color/track_on_light"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />
    </LinearLayout>
</FrameLayout>
