<?xml version="1.0" encoding="utf-8"?>
<!-- The filled violet action on Home's cards (Redeem). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#35FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#6A3BFF" android:endColor="#8457FF" />
            <stroke android:width="1dp" android:color="#9C7BFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
