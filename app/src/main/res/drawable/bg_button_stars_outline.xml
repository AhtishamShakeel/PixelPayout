<?xml version="1.0" encoding="utf-8"?><!--
    The redeem action inside the Stars card, and the gold twin of
    bg_button_xp_outline - same geometry, same weights, same pressed
    behaviour, so the two buttons at the foot of the pair read as one control
    in two colours rather than as a button and a lesser button beside it.

    It was a SOLID gold fill before this. Filled, it was the loudest thing on
    the screen by a wide margin - louder than the balance it acts on - and it
    made the pair asymmetric for no reason the user could see. Outlined, the
    hierarchy is carried where the rest of this screen carries it: in the
    border.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/stars_tint" />
            <stroke android:width="1dp" android:color="@color/stars_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/stars_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
