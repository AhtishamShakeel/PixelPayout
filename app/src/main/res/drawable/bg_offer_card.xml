<?xml version="1.0" encoding="utf-8"?>
<!-- CSS 120deg -> Android 330, rounded to the nearest legal 315. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/offer_grad_start"
        android:endColor="@color/offer_grad_end"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/violet_tint_25" />
    <corners android:radius="20dp" />
</shape>
