<?xml version="1.0" encoding="utf-8"?><!--
    Play hosts the two earning activities that used to be separate bottom-nav
    tabs. Games and Quizzes do the same job for the user - low-effort earning
    that feels like play - so they read better as one destination with two
    tabs than as two competing tabs.

    Deliberately NOT a ViewPager2: QuizListFragment has a SwipeRefreshLayout,
    and horizontal pager swipes fight vertical pull-to-refresh at the edges.
    A TabLayout driving a plain container avoids that entirely, keeps the
    dependency list as it was, and lets the child fragments be hidden rather
    than destroyed so neither list reloads on every tab switch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/playTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/primary_transparent"
        app:tabSelectedTextColor="@color/white"
        app:tabTextAppearance="@style/TextAppearance.PixelPayout.Tab"
        app:tabTextColor="@color/text_secondary" />

    <FrameLayout
        android:id="@+id/playContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
