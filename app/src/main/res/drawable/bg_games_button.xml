<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:state_enabled="false">
    <shape>
      <solid
        android:color="#37304F" />
      <corners
        android:radius="11dp" />
    </shape>
  </item>
  <item
    android:state_pressed="true">
    <shape>
      <solid
        android:color="#6524D9" />
      <corners
        android:radius="11dp" />
    </shape>
  </item>
  <item>
    <shape>
      <gradient
        android:angle="315"
        android:startColor="#A35DFF"
        android:endColor="#541BFF" />
      <stroke
        android:width="1dp"
        android:color="#AF7BFF" />
      <corners
        android:radius="11dp" />
    </shape>
  </item>
</selector>