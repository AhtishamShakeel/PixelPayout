<?xml version="1.0" encoding="utf-8"?>
<!--
    "Selected reward: FF Diamonds - Change reward >", at the top of both
    Wallet goal cards. It names the CURRENCY, not an amount - the amount
    belongs to the card body below it. The whole row opens the chooser.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/selectedRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_selected_reward"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">
    <ImageView
        android:id="@+id/selectedIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:src="@drawable/wallet_stars_art"
        tools:visibility="visible" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_medium"
            android:maxLines="1"
            android:text="@string/wallet_selected_reward"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/selectedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="FF Diamonds" />
    </LinearLayout>
    <TextView
        android:id="@+id/selectedChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/jakarta_bold"
        android:maxLines="1"
        android:text="@string/wallet_change_reward"
        android:textColor="@color/brand_violet_light"
        android:textSize="13sp" />
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/brand_violet_light" />
</LinearLayout>
