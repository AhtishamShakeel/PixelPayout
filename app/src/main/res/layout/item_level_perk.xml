<?xml version="1.0" encoding="utf-8"?><!--
    One thing a level unlocks, inside a rung's `rungPerks`. The icon says
    which kind of thing it is - stars, an unlock, a game - so the lines can
    stay short.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/perkIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_star"
        app:tint="@color/stars_accent" />

    <TextView
        android:id="@+id/perkText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:fontFamily="@font/jakarta_medium"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/text_soft"
        android:textSize="12sp"
        tools:text="+50 ★, paid the moment you reach it" />

</LinearLayout>
