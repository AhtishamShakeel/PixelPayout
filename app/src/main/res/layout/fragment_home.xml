                    <View android:layout_width="0dp" android:layout_height="0dp" app:designX="12" app:designY="139" app:designW="234" app:designH="39" android:tag="reference_xp_chip" android:importantForAccessibility="no" />
                    <TextView style="@style/HomeEarnTileTitle" android:text="@string/home_quizzes" />
                    <TextView style="@style/HomeEarnTileChip" android:text="@string/home_earn_xp" />
                    <ImageView android:layout_width="0dp" android:layout_height="0dp" app:designX="16" app:designY="146" app:designW="29" app:designH="25" android:src="@drawable/ic_bolt" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <ImageView style="@style/HomeEarnTileArrow" />
                </com.example.pixelpayout.ui.home.HomeDesignLayout>
                <com.example.pixelpayout.ui.home.HomeDesignLayout android:id="@+id/offerCard" style="@style/HomeEarnTile" android:layout_marginStart="@dimen/home_tile_gap" android:background="@drawable/bg_home_tile_offers" android:contentDescription="@string/home_offers_tournament">
