<?xml version="1.0" encoding="utf-8"?>
<!--
    One game in the Wallet grid.

    Artwork on top, text below it on the tile's own ground: the image ends
    right above the currency name instead of running under the text behind
    a fade, so the art is shown whole and the text never sits on a busy
    picture.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_tile"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp">
    <!-- The placeholder well, the same box as the art. It stays behind the
         image so a failed load still leaves a labelled tile. -->
    <TextView
        android:id="@+id/gameCode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_code_tile"
        android:fontFamily="@font/mono_bold"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:textColor="@color/brand_violet"
        android:textSize="16sp"
        app:layout_constraintDimensionRatio="H,4:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="UC" />
    <!-- Transparent PNGs, drawn whole and centred on the tile's own ground:
         fitCenter with padding rather than a crop, and no clipping shape. -->
    <ImageView
        android:id="@+id/gameImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/gameCode"
        app:layout_constraintEnd_toEndOf="@id/gameCode"
        app:layout_constraintStart_toStartOf="@id/gameCode"
        app:layout_constraintTop_toTopOf="@id/gameCode" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gameCode">
        <TextView
            android:id="@+id/gameName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="UC" />
        <TextView
            android:id="@+id/gameFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_medium"
            android:maxLines="1"
            android:textColor="@color/text_ghost"
            android:textSize="13sp"
            tools:text="from 1,200 stars" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
