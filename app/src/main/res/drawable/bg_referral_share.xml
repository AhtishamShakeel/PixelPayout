<?xml version="1.0" encoding="utf-8"?>
<!-- The filled Share button beside the referral code. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/brand_violet"
                android:startColor="@color/brand_violet_light" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
