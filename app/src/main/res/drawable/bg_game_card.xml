<?xml version="1.0" encoding="utf-8"?>
<!-- Nocturne's #232532 game row: a step lighter than the counter panel above
     it, so the two surfaces stay distinguishable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_sheet" />
            <stroke android:width="1dp" android:color="@color/brand_violet_deep" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_row" />
            <stroke android:width="1dp" android:color="@color/stroke_card" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
