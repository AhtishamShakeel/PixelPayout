<?xml version="1.0" encoding="utf-8"?><!--
    "What do you want to earn?" - picks the redemption game Home's Stars card
    measures against. Same card, type and spacing as dialog_ad_claim, shown
    through CustomDialogTheme.

    The options are inflated into `gameChoiceOptions` from the live catalogue
    (item_game_choice), so a game added in the console appears here without a
    release.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_level_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jakarta_bold"
        android:text="@string/game_choice_title"
        android:textColor="@color/white"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/jakarta_medium"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/game_choice_message"
        android:textColor="@color/text_faint"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/gameChoiceOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

</LinearLayout>
