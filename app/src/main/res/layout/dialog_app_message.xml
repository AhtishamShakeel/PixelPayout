<?xml version="1.0" encoding="utf-8"?><!--
    The app's own message dialog: a title, a body, and one or two buttons.

    THE POINT OF IT IS THAT IT IS NOT AlertDialog. The platform builder paints
    itself from colorSurface with the platform's own typography and radius, so
    it lands on top of these screens looking like a different app - pale grey
    card, wrong font, square-ish corners, SHOUTING BUTTON LABELS. The same
    reasoning is already written down on dialog_ad_claim, which is the
    hand-built dialog this generalises: that one is specifically the
    watch-an-ad confirmation, and everything else that needed to say something
    fell back to AlertDialog and looked foreign.

    Driven entirely from code - see AppDialog.kt - so a caller needs no layout
    of its own. Shown through CustomDialogTheme, whose window background is
    transparent, so the rounded card below is the whole visible dialog.

    Everything except the title and the primary button is optional and hidden
    by default: the icon, the body, and the secondary button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_level_card"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
            A glyph when the caller gives one, a dot when it does not. Both
            carry the accent, which is the only colour on the card: the
            palette's rule is that accent belongs in the glyph and the figure
            rather than under them, so there is no tinted chip behind this.
        -->
        <ImageView
            android:id="@+id/appDialogIcon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:src="@drawable/ic_gift"
            tools:visibility="visible" />

        <View
            android:id="@+id/appDialogDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dialog_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="-0.01"
            android:textColor="@color/white"
            android:textSize="17sp"
            tools:text="Already claimed" />

    </LinearLayout>

    <TextView
        android:id="@+id/appDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/jakarta_medium"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/text_faint"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="The one-time offer has already been used on this game account. Your stars have not been spent."
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!--
            Sentence case, not the platform's all-caps. "Got it" is a thing a
            person says; "GOT IT" is a thing a 2014 dialog says.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appDialogNegative"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textAllCaps="false"
            android:textColor="@color/text_faint"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Cancel"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appDialogPositive"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/jakarta_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/brand_violet"
            app:cornerRadius="12dp"
            tools:text="Got it" />

    </LinearLayout>

</LinearLayout>
