<?xml version="1.0" encoding="utf-8"?><!--
    Everything above the ladder: the back bar, the hero card, the
    earned/ahead pair and the ladder heading.

    A separate file because the ladder is now a RecyclerView, and the
    RecyclerView is the screen's scroller rather than a block inside one.
    This is its first row - see LevelRewardsFragment for why it could not
    stay nested in a NestedScrollView.

    The 10dp of bottom padding is what the rows LinearLayout used to carry as
    layout_marginTop, kept here so the gap under the heading is unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <!-- ================= Header ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/levelRewardsBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="@string/leaderboard_back"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_dim" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_semibold"
                android:letterSpacing="0.14"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/text_ghost"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jakarta_semibold"
                android:letterSpacing="-0.01"
                android:text="@string/level_rewards_title"
                android:textColor="@color/text_strong"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= Where you are ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_offer_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_chip_violet"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:text="@string/level_rewards_lv"
                    android:textAllCaps="true"
                    android:textColor="@color/text_ghost"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/levelRewardsLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/mono_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/brand_violet_light"
                    android:textSize="21sp"
                    tools:text="7" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/levelRewardsHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="Level 7" />

                <TextView
                    android:id="@+id/levelRewardsHeroXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp"
                    tools:text="1,240 lifetime XP" />

            </LinearLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/levelRewardsProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_violet"
            tools:progress="45" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/levelRewardsNextNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_medium"
                android:maxLines="1"
                android:textColor="@color/text_faint"
                android:textSize="12sp"
                tools:text="Next: Level 8" />

            <TextView
                android:id="@+id/levelRewardsNextTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/mono_medium"
                android:textColor="@color/text_ghost"
                android:textSize="12sp"
                tools:text="1,240 / 1,510 XP" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= Locked rewards ================= -->
    <!--
        Only present when a level has been reached and its stars have not been
        released yet. Everything about it is bound in code and it starts GONE,
        so on the ordinary visit - nothing owing - the screen is exactly what
        it was before this existed.

        It sits directly under the hero card rather than at the top of the
        ladder because it is about a level already climbed: the hero says
        where you are, this says what that owes you, and the ladder below is
        still the forward-looking part.
    -->
    <LinearLayout
        android:id="@+id/levelClaimCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_first_redeem_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_stars" />

            <TextView
                android:id="@+id/levelClaimTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_bold"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="Level 4 reward ready" />

            <TextView
                android:id="@+id/levelClaimAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/mono_bold"
                android:textColor="@color/stars_accent"
                android:textSize="17sp"
                tools:text="+7 ★" />

        </LinearLayout>

        <TextView
            android:id="@+id/levelClaimNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jakarta_medium"
            android:textColor="@color/text_faint"
            android:textSize="12sp"
            tools:text="2 more waiting after this one, claimed in order." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/levelClaimButton"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/jakarta_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="@string/level_claim_watch"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/brand_violet"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- ================= Earned / ahead ================= -->
    <!--
        Both figures are milestone STARS only, because those are the only
        level reward that is a number. Unlocks are counted on the ladder
        below, where they can say what they are.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/levelRewardsEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_bold"
                android:textColor="@color/stars_accent"
                android:textSize="17sp"
                tools:text="75 ★" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/level_rewards_earned_label"
                android:textColor="@color/text_ghost"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/levelRewardsAhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_bold"
                android:textColor="@color/text_soft"
                android:textSize="17sp"
                tools:text="575 ★" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/level_rewards_ahead_label"
                android:textColor="@color/text_ghost"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= The ladder ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="-0.013"
            android:text="@string/level_rewards_ladder"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/levelRewardsLadderNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/jakarta_medium"
            android:textColor="@color/text_ghost"
            android:textSize="11.5sp"
            tools:text="10 of 30 levels pay out" />

    </LinearLayout>

</LinearLayout>
