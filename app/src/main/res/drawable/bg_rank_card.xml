<?xml version="1.0" encoding="utf-8"?>
<!-- The pinned "your rank" card. CSS 135deg -> Android 315. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/rank_card_start"
        android:endColor="@color/rank_card_end"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/violet_tint_35" />
    <corners android:radius="20dp" />
</shape>
