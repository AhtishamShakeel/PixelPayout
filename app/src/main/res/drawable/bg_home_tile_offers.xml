<?xml version="1.0" encoding="utf-8"?>
<!-- A Start earning tile's ground. The illustrated tiles draw their art over
     it; a tile without art shows this gradient on its own. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#35FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#075FE2" android:endColor="#081C51" />
            <stroke android:width="1dp" android:color="#256BD1" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
