<?xml version="1.0" encoding="utf-8"?><!--
    A tap target with no surface of its own.

    Mask only, no content layer: the goal rows sit on the goals card and are
    not cards themselves, so this has to add a bounded ripple WITHOUT painting
    a background over the card underneath - which is what card_ripple_effect
    would do, since it carries dark_card_background as its content layer.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
