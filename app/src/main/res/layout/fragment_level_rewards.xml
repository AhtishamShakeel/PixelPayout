<?xml version="1.0" encoding="utf-8"?><!--
    Level rewards, built on the LevelRewards.dc.html handoff and painted in
    this app's palette (see the Wallet block in colors.xml for the mapping).

    Four departures from the handoff, all because of what this economy
    actually does rather than preference:

      * No "Claim reward" button, and no "N to claim" badge. Milestone stars
        are paid by awardReward inside the same transaction that crosses the
        level - there is nothing left for a button to do, and one that only
        looked like it worked would be worse than none.
      * No level NAMES ("Rookie", "Mythic"). Levels here are numbers on a
        curve; there is no name table to read one from.
      * Thresholds are XP, not "lifetime points". Points are spent at
        cashout; XP is what the curve is built on.
      * Only levels that unlock something are listed. Every level from 2 up
        pays stars, so in practice that is the whole climb; level 1 is absent
        because accounts are CREATED there and it is never crossed, so a rung
        for it could never pay. The note under the section heading counts what
        is listed against the curve's top level, which is what shows when a
        level has been emptied in the console.

    The bottom nav is the activity's PixelBottomNav, not redrawn here.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="12dp"
        android:paddingEnd="17dp"
        android:paddingBottom="24dp">

        <!-- ================= Header ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/levelRewardsBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/leaderboard_back"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_semibold"
                    android:letterSpacing="0.14"
                    android:text="@string/app_name"
                    android:textAllCaps="true"
                    android:textColor="@color/text_ghost"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jakarta_semibold"
                    android:letterSpacing="-0.01"
                    android:text="@string/level_rewards_title"
                    android:textColor="@color/text_strong"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= Where you are ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_offer_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_chip_violet"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.12"
                        android:text="@string/level_rewards_lv"
                        android:textAllCaps="true"
                        android:textColor="@color/text_ghost"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/levelRewardsLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/mono_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/brand_violet_light"
                        android:textSize="21sp"
                        tools:text="7" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/levelRewardsHeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:letterSpacing="-0.01"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        tools:text="Level 7" />

                    <TextView
                        android:id="@+id/levelRewardsHeroXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/jakarta_medium"
                        android:textColor="@color/text_faint"
                        android:textSize="12sp"
                        tools:text="1,240 lifetime XP" />

                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/levelRewardsProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_violet"
                tools:progress="45" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/levelRewardsNextNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/jakarta_medium"
                    android:maxLines="1"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp"
                    tools:text="Next: Level 8" />

                <TextView
                    android:id="@+id/levelRewardsNextTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/mono_medium"
                    android:textColor="@color/text_ghost"
                    android:textSize="12sp"
                    tools:text="1,240 / 1,510 XP" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= Earned / ahead ================= -->
        <!--
            Both figures are milestone STARS only, because those are the only
            level reward that is a number. Unlocks are counted on the ladder
            below, where they can say what they are.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_summary_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/levelRewardsEarned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono_bold"
                    android:textColor="@color/gold"
                    android:textSize="17sp"
                    tools:text="75 ★" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/level_rewards_earned_label"
                    android:textColor="@color/text_ghost"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_summary_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/levelRewardsAhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono_bold"
                    android:textColor="@color/text_soft"
                    android:textSize="17sp"
                    tools:text="575 ★" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/level_rewards_ahead_label"
                    android:textColor="@color/text_ghost"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= The ladder ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:letterSpacing="-0.013"
                android:text="@string/level_rewards_ladder"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/levelRewardsLadderNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jakarta_medium"
                android:textColor="@color/text_ghost"
                android:textSize="11.5sp"
                tools:text="10 of 30 levels pay out" />

        </LinearLayout>

        <!--
            Rows are inflated at bind time rather than adapted. The ladder is
            bounded by the level curve - thirty rungs at the absolute most,
            and in practice around ten - so a RecyclerView and its adapter
            would be more machinery than the content justifies.
        -->
        <LinearLayout
            android:id="@+id/levelRewardsRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Shown instead of the rows while the curve is still in flight, or
             if it never arrives. -->
        <TextView
            android:id="@+id/levelRewardsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="center"
            android:text="@string/level_rewards_loading"
            android:textColor="@color/text_ghost"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_info_note"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="@color/brand_violet_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_medium"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/level_rewards_note"
                android:textColor="@color/text_faint"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
