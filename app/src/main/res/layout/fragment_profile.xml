<?xml version="1.0" encoding="utf-8"?><!--
    Profile.

    No longer the placeholder it was: it now owns referrals, both halves of
    them. Wallet is where a balance is spent, and neither giving out a code
    nor claiming someone else's has anything to do with spending - they are
    facts about who this account is, which is what this tab is for.

    The two halves are one card, not two, because they are one subject. The
    lower half retires itself once the code has been claimed; the upper half
    is permanent.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="-0.013"
            android:text="@string/nav_profile"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- ================= Who ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_16"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_user_avatar"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PixelPayout.Circle"
                app:tint="@color/text_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jakarta_bold"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="Ahtisham" />

                <TextView
                    android:id="@+id/profileMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:textColor="@color/text_faint"
                    android:textSize="11.5sp"
                    tools:text="Level 4 · 1,240 stars" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= Referrals ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_offer_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_semibold"
                android:letterSpacing="0.13"
                android:text="@string/referral_section_label"
                android:textAllCaps="true"
                android:textColor="@color/brand_violet_light"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/jakarta_bold"
                android:letterSpacing="-0.013"
                android:text="@string/referral_invite_title"
                android:textColor="@color/white"
                android:textSize="15.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/referral_reward_description"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <!--
                The user's own code. Tapping anywhere on it copies, which is
                what people try first - the icon is a hint, not the only
                target. Hidden entirely until the user document has actually
                delivered a code, rather than showing an empty box to copy.
            -->
            <LinearLayout
                android:id="@+id/referralCodeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_referral_code"
                android:baselineAligned="false"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/referralCodeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mono_bold"
                    android:letterSpacing="0.18"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    tools:text="4KJ7QA" />

                <ImageView
                    android:id="@+id/referralCopy"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/referral_copy"
                    android:padding="6dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/brand_violet_light" />

                <ImageView
                    android:id="@+id/referralShare"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/referral_share"
                    android:padding="6dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/brand_violet_light" />

            </LinearLayout>

            <!--
                Claiming someone else's code. Once per account, so the whole
                group goes away for good the moment hasUsedReferral is true -
                see ProfileFragment.
            -->
            <LinearLayout
                android:id="@+id/referralClaimGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/stroke_strong" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/jakarta_bold"
                    android:text="@string/referral_claim_title"
                    android:textColor="@color/white"
                    android:textSize="13.5sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/referralInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/text_input_stroke_color"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="@color/text_faint"
                    app:shapeAppearanceOverlay="@style/RoundedTextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/referralCodeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mono_medium"
                        android:hint="@string/enter_referral_code"
                        android:inputType="textCapCharacters"
                        android:letterSpacing="0.12"
                        android:maxLength="6"
                        android:textColor="@color/white"
                        android:textColorHint="@color/text_trace"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/submitReferralButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/jakarta_bold"
                    android:gravity="center"
                    android:text="@string/submit_referral"
                    android:textColor="@color/white"
                    android:textSize="13.5sp" />

            </LinearLayout>

            <!-- What replaces the input once the code has been claimed. -->
            <TextView
                android:id="@+id/referralClaimedNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawablePadding="7dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:text="@string/referral_already_claimed"
                android:textColor="@color/success"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
