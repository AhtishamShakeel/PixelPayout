rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Users may read their own profile only. (The production rules this
      // replaces let ANY signed-in user read ANY other user's full document -
      // not needed by anything in the app since referral lookup moved to
      // the submitReferral Cloud Function.)
      allow read: if request.auth != null && request.auth.uid == userId;

      // No client write of any kind. The document is created by the
      // completeSignup function and only ever modified by reward paths, all
      // of which use the Admin SDK and bypass these rules.
      //
      // (The production rules this replaces allowed full self-write - so a
      // user could set their own points - AND a separate rule letting any
      // OTHER signed-in user increment someone's `points`, almost certainly a
      // leftover from before referral rewards moved server-side.)
      allow write: if false;

      match /rewardEvents/{eventId} {
        // Ledger entries are readable by their owner (for a future
        // "history" screen) but are written only by Cloud Functions.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /gameSessions/{sessionId} {
        // Server-issued and server-consumed; the client only ever holds the id.
        allow read, write: if false;
      }

      match /gameProfiles/{gameId} {
        // The player ID / username this user last redeemed into, so the
        // redeem form can prefill. Owner-readable because it is theirs and
        // says nothing about anyone else; written only by redeemReward.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // No client needs to list/enumerate the users collection - referral
    // code lookup happens server-side in submitReferral via the Admin SDK,
    // which bypasses rules entirely. (The production rules this replaces
    // allowed any signed-in user to list the whole collection.)

    match /redemptions/{redemptionId} {
      // Ownership lives in the document's uid field now that these are
      // top-level. A listing query must filter by uid or it will be denied,
      // which is what stops one user enumerating everyone's payout numbers.
      //
      // There is deliberately NO admin carve-out here. The admin tool reads
      // through the listRedemptions function (Admin SDK, which bypasses these
      // rules), so no browser client - admin or not - is ever granted read
      // access across users.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      // Nobody writes here directly, admins included: approving or refunding
      // goes through resolveRedemption, which keeps the refund and the status
      // change atomic. Setting status by hand would skip the refund and cost
      // the user their stars.
      allow write: if false;
    }

    // The public payout feed. Readable by every signed-in user - that is the
    // point of it - which is precisely why it is a separate collection from
    // `redemptions`, whose documents carry uids and payout phone numbers and
    // stay owner-only above.
    //
    // Written only by resolveRedemption through the Admin SDK, which bypasses
    // these rules. No client writes here, admin or not.
    match /payoutFeed/{entryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Secrets. NOTHING here is ever client-readable.
    //
    // A separate collection from `config` precisely because that one grants
    // every signed-in user read access - which is right for the level curve
    // and the goal bonus, and catastrophic for an offerwall's shared secret,
    // since anyone holding it can forge a postback and mint stars. Denying
    // the whole collection rather than naming documents means the next
    // secret added here is safe by default rather than safe only if somebody
    // remembers to extend a rule.
    match /serverConfig/{docId} {
      allow read, write: if false;
    }

    match /redemptionOptions/{optionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The claim on a game player ID. NO client access of any kind, not even
    // read: this collection answers "is this player ID taken", and a client
    // able to ask that could map which IDs belong to accounts on the way to
    // working around the one-account-per-ID rule it exists to enforce.
    // redeemReward reads and writes it through the Admin SDK.
    match /playerLinks/{linkId} {
      allow read, write: if false;
    }

    // Settled offerwall postbacks, one document per network transaction.
    // Server-only, and denied explicitly rather than left to the catch-all
    // because this is the record that stops a transaction paying twice: a
    // client able to write here could erase its own idempotency marker and
    // replay a completion, and one able to read it could enumerate other
    // users' uids alongside the amounts they earned.
    match /offerwallTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /supportTickets/{ticketId} {
      // Owners read their own tickets. Everything is written by Cloud
      // Functions (createSupportTicket, replySupportTicket, ...), which
      // enforce one active ticket, message length and the daily cap.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      // The one client write: an owner marking a reply as seen. Only the
      // userUnread flag may change, and only to false.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userUnread'])
        && request.resource.data.userUnread == false;

      allow create, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
