<?xml version="1.0" encoding="utf-8"?>
<!-- Back button, title and subtitle shared by the support screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/supportBack"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_back_button"
        android:contentDescription="@string/leaderboard_back"
        android:padding="5dp"
        android:src="@drawable/ic_chevron_left"
        app:tint="@color/text_dim" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/supportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_semibold"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/text_strong"
            android:textSize="20sp"
            tools:text="Contact support" />

        <TextView
            android:id="@+id/supportSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_medium"
            android:maxLines="1"
            android:textColor="@color/text_ghost"
            android:textSize="12sp"
            tools:text="Tell us what happened" />
    </LinearLayout>

</LinearLayout>
