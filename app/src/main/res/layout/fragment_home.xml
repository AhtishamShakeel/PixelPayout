            currency's art on the right, and one row of actions across the
            bottom - Redeem taking most of it, Change beside it.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/starsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_stars_card" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp" app:designX="0" app:designY="0" app:designW="946" app:designH="0" app:designGap="10dp">
            <TextView android:id="@+id/rewardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:fontFamily="@font/jakarta_bold" android:includeFontPadding="false" android:maxLines="1" android:text="@string/home_your_reward" android:textColor="@color/home_title" android:textSize="15sp" app:layout_constraintEnd_toStartOf="@id/rewardArtwork" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:id="@+id/rewardAmount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginEnd="8dp" android:fontFamily="@font/jakarta_extrabold" android:includeFontPadding="false" android:letterSpacing="-0.02" android:maxLines="1" android:text="@string/home_choose_reward" android:textColor="@color/white" android:textSize="34sp" app:autoSizeMaxTextSize="34sp" app:autoSizeMinTextSize="16sp" app:autoSizeStepGranularity="1sp" app:autoSizeTextType="uniform" app:layout_constraintEnd_toStartOf="@id/rewardArtwork" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/rewardTitle" tools:text="2400 CP" />
            <LinearLayout android:id="@+id/nextTierGroup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginEnd="16dp" android:orientation="vertical" app:layout_constraintEnd_toStartOf="@id/rewardArtwork" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/rewardAmount">
                <TextView android:id="@+id/balanceTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/jakarta_semibold" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/home_title" android:textSize="14sp" app:autoSizeMaxTextSize="14sp" app:autoSizeMinTextSize="10sp" app:autoSizeStepGranularity="0.5sp" app:autoSizeTextType="uniform" tools:text="26,000 stars to unlock" />
                <!-- The bar with its figures beside it, as on Wallet's card. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                    <ProgressBar android:id="@+id/redemptionProgress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:max="100" android:minHeight="0dp" android:progressDrawable="@drawable/progress_home_reference" tools:progress="30" />
                    <TextView android:id="@+id/balanceCurrent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/jakarta_semibold" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/white" android:textSize="12sp" tools:text="11,550 / 26,000 ★" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:id="@+id/rewardArtwork" android:layout_width="118dp" android:layout_height="108dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/ic_gift" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <androidx.constraintlayout.widget.Barrier android:id="@+id/starsBodyBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom" app:constraint_referenced_ids="rewardAmount,nextTierGroup,rewardArtwork" />
            <LinearLayout android:id="@+id/starsActions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:baselineAligned="false" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/starsBodyBottom">
                <TextView android:id="@+id/btnPayout" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="7" android:background="@drawable/bg_home_primary_button" android:clickable="true" android:focusable="true" android:fontFamily="@font/jakarta_bold" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/home_see_rewards" android:textColor="@color/white" android:textSize="15sp" app:autoSizeMaxTextSize="15sp" app:autoSizeMinTextSize="10sp" app:autoSizeStepGranularity="0.5sp" app:autoSizeTextType="uniform" />
                <TextView android:id="@+id/starsGameSwitch" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="3" android:background="@drawable/bg_home_secondary_button" android:clickable="true" android:contentDescription="@string/stars_switch_game_desc" android:focusable="true" android:fontFamily="@font/jakarta_bold" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="@string/home_change" android:textColor="@color/home_title" android:textSize="14sp" app:autoSizeMaxTextSize="14sp" app:autoSizeMinTextSize="10sp" app:autoSizeStepGranularity="0.5sp" app:autoSizeTextType="uniform" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- LEVEL PROGRESS: badge and bar on the left, the next level's bonus
