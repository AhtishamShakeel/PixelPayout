    <!-- Dark theme specific colors -->
    <!--
        The page background, moved from #121212 to the design's near-black.

        Changed in place rather than added alongside, because this token is
        also what the toolbar, the Play tab, the nav bar and the punch-out in
        bg_level_badge/circular_background paint themselves. Pointing only the
        theme at a new colour would leave every one of those a visibly
        lighter grey against the window - a seam at the top of each screen.

        Cards using card_dark (#2D2D2D) now sit on a darker page and so read
        with more contrast than before. That is the thing to look at on the
        screens not yet redrawn.
    -->
    <color name="background_dark">#08080D</color>
    <color name="surface_dark">#1E1E1E</color>
    <color name="card_dark">#2D2D2D</color>
    <color name="difficulty_easy">#4CAF50</color>
