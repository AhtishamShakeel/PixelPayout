<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/giftCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_game_tile"
    android:clickable="true"
    android:focusable="true"
    android:padding="2dp">
    <TextView
        android:id="@+id/giftCode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_code_tile"
        android:fontFamily="@font/mono_bold"
        android:gravity="top|center_horizontal"
        android:textColor="@color/brand_violet"
        android:textSize="20sp"
        tools:text="UC"
        android:paddingTop="24dp" />
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/giftImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/giftCode"
        app:layout_constraintEnd_toEndOf="@id/giftCode"
        app:layout_constraintTop_toTopOf="@id/giftCode"
        app:layout_constraintBottom_toBottomOf="@id/giftCode"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LootLevel.GameArt" />
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_reward_art_fade"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/giftCode"
        app:layout_constraintEnd_toEndOf="@id/giftCode"
        app:layout_constraintBottom_toBottomOf="@id/giftCode"
        app:layout_constraintTop_toTopOf="@id/giftCode" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/giftAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_bold"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="20 UC" />
        <LinearLayout
            android:id="@+id/giftCostRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/giftStar"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star"
                app:tint="@color/stars_accent" />
            <TextView
                android:id="@+id/giftCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/mono_bold"
                android:textColor="@color/stars_accent"
                android:textSize="13sp"
                tools:text="150" />
        </LinearLayout>
        <TextView
            android:id="@+id/giftShort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_medium"
            android:maxLines="1"
            android:textColor="@color/text_ghost"
            android:textSize="11.5sp"
            android:visibility="gone"
            tools:text="Need 50 more"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>