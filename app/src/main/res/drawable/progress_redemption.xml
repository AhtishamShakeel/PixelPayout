<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/track_light" />
        </shape>
    </item>
    <!-- Progress: same gold gradient as progress_bonus, pointed at the next
         redemption tier rather than the daily bonus. -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/star_gold_dark"
                    android:endColor="@color/star_gold"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
