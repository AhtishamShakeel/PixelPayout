<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/earn_background" android:fillViewport="true"
    android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="6dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/leaderboardRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_earn_hero" android:orientation="vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="12dp" android:paddingBottom="12dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="128dp">
                <ImageView android:id="@+id/tournamentArt"
                    android:layout_width="0dp" android:layout_height="0dp"
                    android:background="@drawable/bg_earn_glow"
                    android:importantForAccessibility="no" android:scaleType="fitCenter"
                    android:src="@drawable/earn_tournament_art"
                    app:layout_constraintWidth_percent="0.38"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
                <LinearLayout android:id="@+id/tournamentHeading"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:orientation="vertical"
                    app:layout_constraintWidth_percent="0.68"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
                    <TextView style="@style/EarnLabel" android:layout_width="match_parent"
                        android:text="@string/earn_weekly" android:fontFamily="@font/jakarta_bold"
                        android:textSize="28sp" android:letterSpacing="-0.04" />
                    <TextView style="@style/EarnLabel" android:layout_width="match_parent"
                        android:text="@string/earn_tournament" android:fontFamily="@font/jakarta_bold"
                        android:textSize="25sp" android:letterSpacing="-0.04" android:textColor="@color/earn_accent" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rankChip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_earn_chip"
                    android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="12dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tournamentHeading">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp"
                        android:src="@drawable/ic_trophy" app:tint="@color/stars_accent" android:importantForAccessibility="no" />
                    <TextView style="@style/EarnLabel" android:layout_marginStart="8dp" android:text="@string/earn_rank_by_xp" />
                </LinearLayout>
                <androidx.constraintlayout.widget.Barrier android:id="@+id/heroBottom"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:barrierDirection="bottom" app:constraint_referenced_ids="rankChip,tournamentArt" />
                <TextView android:id="@+id/leaderboardSubtitle" style="@style/EarnBody"
                    android:layout_width="match_parent" android:layout_marginTop="6dp" android:layout_marginBottom="8dp"
                    android:text="@string/leaderboard_subtitle_loading" tools:text="Entry closes in 2 days, 5 hours"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/heroBottom"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="5dp" android:background="@drawable/bg_earn_panel"
                    android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
                            android:background="@drawable/bg_earn_chip" android:src="@drawable/ic_user_avatar"
                            app:tint="@color/brand_violet_light" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/leaderboardRank" style="@style/EarnLabel" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/leaderboard_placeholder" tools:text="#1 · You" />
                    </LinearLayout>
                    <TextView android:id="@+id/leaderboardMyXp" style="@style/EarnValue"
                        android:textColor="@color/xp_accent"
                        android:layout_marginTop="5dp" android:text="@string/leaderboard_placeholder" tools:text="350 XP" />
                    <TextView style="@style/EarnBody" android:layout_marginTop="4dp" android:textSize="11sp" android:text="@string/earn_your_xp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="5dp" android:background="@drawable/bg_earn_panel"
                    android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
                            android:background="@drawable/bg_earn_chip" android:src="@drawable/ic_nav_earn"
                            app:tint="@color/brand_violet_light" android:importantForAccessibility="no" />
                        <TextView style="@style/EarnLabel" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/earn_prize_pool" />
                    </LinearLayout>
                    <TextView android:id="@+id/leaderboardPrizePool" style="@style/EarnValue"
                        android:layout_marginTop="5dp" android:text="@string/leaderboard_placeholder" tools:text="2,450 ★" />
                    <TextView android:id="@+id/leaderboardPrizeShare" style="@style/EarnBody"
                        android:layout_marginTop="4dp" android:textSize="11sp"
                        android:text="@string/leaderboard_placeholder" tools:text="Top 30 share" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/viewTournament" style="@style/EarnButton"
                android:layout_width="match_parent" android:layout_marginTop="8dp"
                android:clickable="true" android:focusable="true"
                android:text="@string/earn_view_tournament" android:drawableEnd="@drawable/ic_earn_arrow"
                android:drawableTint="@color/white" />
        </LinearLayout>
        <TextView android:id="@+id/offerwallTitle" style="@style/EarnLabel"
            android:layout_width="match_parent" android:layout_marginTop="16dp"
            android:fontFamily="@font/jakarta_bold" android:textSize="24sp"
            android:letterSpacing="-0.03" android:text="@string/earn_offers_heading" />
        <TextView style="@style/EarnBody" android:layout_width="match_parent"
            android:layout_marginTop="3dp" android:text="@string/earn_offers_subtitle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_earn_panel"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:gravity="center_vertical" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_earn_phone" android:importantForAccessibility="no" />
                <TextView style="@style/EarnLabel" android:layout_marginTop="4dp"
                    android:textSize="11sp" android:gravity="center" android:text="@string/earn_step_choose" />
            </LinearLayout>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginBottom="16dp"
                android:src="@drawable/ic_earn_arrow" app:tint="@color/earn_accent" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_earn_complete" android:importantForAccessibility="no" />
                <TextView style="@style/EarnLabel" android:layout_marginTop="4dp"
                    android:textSize="11sp" android:gravity="center" android:text="@string/earn_step_complete" />
            </LinearLayout>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginBottom="16dp"
                android:src="@drawable/ic_earn_arrow" app:tint="@color/earn_accent" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:layout_width="46dp" android:layout_height="40dp"
                    android:src="@drawable/ic_earn_stars" android:importantForAccessibility="no" />
                <TextView style="@style/EarnLabel" android:layout_marginTop="4dp"
                    android:textSize="11sp" android:gravity="center" android:text="@string/earn_step_stars" />
            </LinearLayout>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/offerwallList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" android:visibility="gone"
            tools:visibility="visible" tools:listitem="@layout/item_offerwall" tools:itemCount="1" />
        <ProgressBar android:id="@+id/offerwallLoading" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center_horizontal" android:layout_margin="24dp" android:indeterminateTint="@color/earn_accent" />
        <LinearLayout android:id="@+id/offerwallEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_earn_panel" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
            <TextView style="@style/EarnLabel" android:text="@string/offerwall_empty_title" android:textSize="16sp" />
            <TextView style="@style/EarnBody" android:layout_width="match_parent"
                android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="@string/offerwall_empty_body" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
