<?xml version="1.0" encoding="utf-8"?><!--
    The Stars half of the pair at the top of Home.

    A tinted dark surface, NOT the old bg_balance_card's saturated violet
    fill. Two cards side by side both painted that loudly would fight each
    other and drown everything below them - which is what the full-width
    balance card was already doing on its own.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/offer_grad_start"
        android:endColor="@color/offer_grad_end"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/violet_tint_35" />
    <corners android:radius="18dp" />
</shape>
