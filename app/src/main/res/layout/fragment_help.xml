<?xml version="1.0" encoding="utf-8"?><!--
    Help & Support: common questions, then a way to reach a person through
    an in-app support ticket.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="12dp"
        android:paddingEnd="17dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/helpBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/leaderboard_back"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_semibold"
                    android:letterSpacing="-0.01"
                    android:text="@string/help_title"
                    android:textColor="@color/text_strong"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/help_subtitle"
                    android:textColor="@color/text_ghost"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Sections and questions are added by HelpFragment. -->
        <LinearLayout
            android:id="@+id/helpSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ================= Contact ================= -->
        <LinearLayout
            android:id="@+id/helpContactCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_info_note"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_referral_badge">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_help"
                        app:tint="@color/brand_violet_light" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jakarta_semibold"
                    android:text="@string/help_contact_title"
                    android:textColor="@color/text_strong"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/jakarta_medium"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/help_contact_body"
                android:textColor="@color/text_faint"
                android:textSize="12.5sp" />

            <!-- My tickets: shown once the account has any. The gold dot
                 means support has replied. -->
            <LinearLayout
                android:id="@+id/helpMyTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_reply_input"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/helpMyTicketsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jakarta_semibold"
                    android:text="@string/help_my_tickets"
                    android:textColor="@color/text_strong"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/helpMyTicketsReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/jakarta_semibold"
                    android:gravity="center_vertical"
                    android:text="@string/help_new_reply"
                    android:textColor="@color/gold"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/bg_unread_dot" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_row_caret" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/helpContactButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_referral_share"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/helpContactLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:text="@string/help_contact_button"
                    android:textColor="@color/white"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/helpTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/jakarta_semibold"
                android:minHeight="40dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/legal_terms_title"
                android:textColor="@color/brand_violet_light"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:textColor="@color/text_ghost" />

            <TextView
                android:id="@+id/helpPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/jakarta_semibold"
                android:minHeight="40dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/legal_privacy_title"
                android:textColor="@color/brand_violet_light"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
