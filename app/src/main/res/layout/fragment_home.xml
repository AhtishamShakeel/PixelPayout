<?xml version="1.0" encoding="utf-8"?><!--
    Home.

    A vertical LinearLayout rather than a ConstraintLayout: these are stacked
    full-width sections, so constraints bought nothing and made reordering
    painful. When sections start appearing conditionally per user state, this
    should become a RecyclerView with view types - not before.

    Level and XP no longer live here. They are the ring around the toolbar
    avatar, which frees this screen of a second progress bar sitting a few
    dozen pixels from the balance one.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= Balance ================= -->
        <LinearLayout
            android:id="@+id/balanceLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dashboard_ui"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend_bold"
                android:text="@string/balance_title"
                android:textColor="@color/primary_text"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/totalPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lexend_bold"
                    android:textColor="@color/primary_text"
                    android:textSize="26sp"
                    tools:text="450" />

            </LinearLayout>

            <!--
                Fills toward the cheapest redemption not yet affordable. Hidden
                outright when there is no such target, rather than showing a
                permanently full bar that means nothing.
            -->
            <LinearLayout
                android:id="@+id/nextTierGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/redemptionProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_redemption"
                    tools:progress="90" />

                <TextView
                    android:id="@+id/nextTierText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/lexend_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="50 more unlocks 100 UC" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayout"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/lexend_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/redeem"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="23dp" />

        </LinearLayout>

        <!-- ================= Active buff ================= -->
        <!--
            Only visible while a buff is running. The subtitle is not decoration:
            buffs are source-gated server-side, so saying plainly that the payout
            rate is untouched is the difference between a bonus and a surprise.
        -->
        <LinearLayout
            android:id="@+id/buffCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface_12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/buffText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_bold"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="2x XP boost" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_regular"
                    android:text="@string/buff_rate_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/buffTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/lexend_bold"
                android:textColor="@color/primary"
                android:textSize="14sp"
                tools:text="01:42:18" />

        </LinearLayout>

        <!-- ================= Keep earning ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lexend_bold"
            android:text="@string/keep_earning"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <include
            android:id="@+id/gameRow"
            layout="@layout/item_slim_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <include
            android:id="@+id/quizRow"
            layout="@layout/item_slim_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
