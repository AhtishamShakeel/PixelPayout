                <com.example.pixelpayout.ui.home.HomeDesignLayout android:id="@+id/quizTile" style="@style/HomeEarnTile" android:layout_marginStart="@dimen/home_tile_gap" android:background="@drawable/bg_home_tile_quizzes" android:contentDescription="@string/home_quizzes">
