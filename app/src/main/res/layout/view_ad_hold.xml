<?xml version="1.0" encoding="utf-8"?>
<!--
  The brief pause shown before an interstitial. See AdHold.

  Opaque rather than a translucent scrim: it is standing in for the moment
  between one screen ending and a full-screen ad starting, and a see-through
  panel over a results card would leave the buttons underneath visible and
  looking tappable while they are not.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:gravity="center"
    android:orientation="vertical">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ad_hold_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
