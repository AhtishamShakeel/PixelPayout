<?xml version="1.0" encoding="utf-8"?><!--
    The Play and Quiz tiles. Both are XP sources, so both take the XP border.

    Shared ground, accent in the hairline - the rule every card on Home
    follows. See bg_stat_card_stars.xml for why.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_card" />
    <stroke android:width="1dp" android:color="@color/xp_stroke" />
    <corners android:radius="16dp" />
</shape>
