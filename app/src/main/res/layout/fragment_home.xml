            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="12dp" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="@id/levelBadge" app:layout_constraintEnd_toStartOf="@id/levelDivider" app:layout_constraintStart_toEndOf="@id/levelBadge" app:layout_constraintTop_toTopOf="@id/levelBadge">
                <TextView android:id="@+id/levelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/jakarta_bold" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/white" android:textSize="18sp" tools:text="Level 2" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                    <ProgressBar android:id="@+id/levelProgressBar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:max="100" android:minHeight="0dp" android:progressDrawable="@drawable/progress_home_reference" tools:progress="10" />
                    <TextView android:id="@+id/levelXpCurrent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/jakarta_medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/home_text" android:textSize="12sp" tools:text="6 / 59 XP" />
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.Guideline android:id="@+id/levelSplit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.66" />
            <View android:id="@+id/levelDivider" android:layout_width="1dp" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="#302B55" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/levelSplit" app:layout_constraintTop_toTopOf="parent" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="center_horizontal" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/levelDivider" app:layout_constraintTop_toTopOf="parent">
                <!-- "+6 ★" over "on next level": two short lines fit the column's height, one long one did not fit its width. -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:id="@+id/levelReward" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/jakarta_bold" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/stars_accent" android:textSize="16sp" tools:text="+6 ★" />
                    <TextView android:id="@+id/levelRewardContext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/jakarta_medium" android:includeFontPadding="false" android:maxLines="1" android:text="@string/home_next_level" android:textColor="@color/home_text" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/levelRewardsButton" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:background="@drawable/bg_home_secondary_button" android:clickable="true" android:focusable="true" android:fontFamily="@font/jakarta_bold" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="@string/home_view_levels" android:textColor="@color/white" android:textSize="13sp" app:autoSizeMaxTextSize="13sp" app:autoSizeMinTextSize="9sp" app:autoSizeStepGranularity="0.5sp" app:autoSizeTextType="uniform" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- RECENT PAYOUTS, as one line: live dot, the latest payout, how long ago. -->
        <LinearLayout android:id="@+id/payoutFeedRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="11dp" android:paddingEnd="14dp" android:paddingBottom="11dp" android:visibility="gone" tools:visibility="visible" app:designX="0" app:designY="0" app:designW="946" app:designH="0" app:designGap="10dp">
            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_home_live_dot" />
            <TextView android:id="@+id/payoutFeedText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/jakarta_medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/white" android:textSize="13sp" tools:text="Abd***iz received 30 UC" />
            <TextView android:id="@+id/payoutFeedTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="@font/jakarta_medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/home_text" android:textSize="12sp" tools:text="1d ago" />
        </LinearLayout>

        <!-- START EARNING: the reference's illustrated tiles, three across as
