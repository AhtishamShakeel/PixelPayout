<?xml version="1.0" encoding="utf-8"?><!--
    The full payout feed, opened from the single-line summary on Home.

    A sheet rather than a card on the screen: the feed is social proof, worth
    a glance and occasionally a scroll, and it was costing a whole screenful
    of Home to say what one line says.

    Rows are inflated into `payoutSheetRows` at bind time. The fetch is capped
    at ten, so a RecyclerView and its adapter would be more machinery than the
    content justifies.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- The grab handle. Present because the sheet is draggable, and without
         one nothing says so. -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/jakarta_bold"
        android:text="@string/recent_payouts"
        android:textColor="@color/white"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/jakarta_medium"
        android:text="@string/recent_payouts_subtitle"
        android:textColor="@color/text_faint"
        android:textSize="12.5sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="420dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/payoutSheetRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
