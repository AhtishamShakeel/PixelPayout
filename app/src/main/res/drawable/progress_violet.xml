<?xml version="1.0" encoding="utf-8"?>
<!--
    The violet bar used by the level card and the daily-goal card: gradient
    fill on a near-black track, for bars sitting on a dark surface.

    The gradient runs left-to-right (angle 0) so the fill brightens along its
    own length, matching the design's 90deg CSS gradient.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/track_on_dark" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/brand_violet"
                    android:endColor="@color/brand_violet_light"
                    android:type="linear" />
                <corners android:radius="99dp" />
            </shape>
        </clip>
    </item>
</layer-list>
