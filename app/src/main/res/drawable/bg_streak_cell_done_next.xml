<?xml version="1.0" encoding="utf-8"?><!--
    A cell that is already filled AND is the one the next claim pays for.

    That pairing is the retry state: the streak moved on today but the ad
    failed, so the day is done and its reward is still waiting. Filled like
    bg_streak_cell_done, ringed like bg_streak_cell_next.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/streak_fill" />
    <stroke android:width="2dp" android:color="@color/text_strong" />
    <corners android:radius="6dp" />
</shape>
