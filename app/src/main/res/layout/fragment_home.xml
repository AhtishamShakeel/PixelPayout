        <LinearLayout android:id="@+id/quickActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" app:designX="0" app:designY="0" app:designW="946" app:designH="0" app:designGap="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/jakarta_bold" android:includeFontPadding="false" android:maxLines="1" android:text="@string/home_start_earning" android:textColor="@color/white" android:textSize="20sp" />
                <TextView android:id="@+id/earnAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:clickable="true" android:focusable="true" android:fontFamily="@font/jakarta_medium" android:gravity="end" android:maxWidth="170dp" android:maxLines="2" android:text="@string/home_activities_hint" android:textColor="@color/home_text" android:textSize="11sp" />
