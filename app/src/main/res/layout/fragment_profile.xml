<?xml version="1.0" encoding="utf-8"?><!--
    Profile, built on the Profile.dc.html handoff and painted in this app's
    palette (see the Wallet block in colors.xml for the mapping).

    Four departures from the handoff, all because of what this system
    actually stores rather than preference:

      * The three stat tiles are Stars, Lifetime XP and Day streak. The
        handoff shows "Points earned / Quizzes done / Games played"; none of
        those three counters exist - the ledger records events, nothing
        totals them per user - and inventing them would put numbers on screen
        that no code maintains.
      * No level NAME ("Grinder"). Levels here are numbers on a curve; there
        is no name table to read one from.
      * No "Phone verification" row. There is no phone verification in this
        app, by decision.
      * Referral progress measures XP toward the unlock threshold, not level.
        That is the condition readReferrerForUnlock actually tests, so a bar
        measuring anything else would fill at a different rate than the
        reward arrives.

    The bottom nav is the activity's PixelBottomNav, not redrawn here.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="11dp"
        android:paddingEnd="17dp"
        android:paddingBottom="24dp">

        <!-- ================= Identity ================= -->
        <!--
            First thing on the screen. The app name and the tab name used to
            sit above it, but the activity toolbar carries both already, so
            this was the same two words twice on one screen.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileInitials"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_profile_avatar"
                android:fontFamily="@font/jakarta_semibold"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:textColor="@color/brand_violet_light"
                android:textSize="22sp"
                tools:text="AS" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The name is already on the top bar, so the email leads. -->
                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jakarta_semibold"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:textColor="@color/text_strong"
                    android:textSize="16sp"
                    tools:text="ahtisham@gmail.com" />

                <TextView
                    android:id="@+id/profileMemberSince"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_ghost"
                    android:textSize="11sp"
                    app:drawableStartCompat="@drawable/ic_history"
                    app:drawableTint="@color/text_ghost"
                    tools:text="Member since Jun 2026" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= Stats ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/statStars"
                layout="@layout/item_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/statXp"
                layout="@layout/item_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/statStreak"
                layout="@layout/item_profile_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ================= Refer & Earn ================= -->
        <!--
            Home's "Refer and earn" row lands here, so the card carries an id:
            without one the tab opens on the account block and the user has to
            hunt for the thing they tapped.
        -->
        <LinearLayout
            android:id="@+id/inviteHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_referral_badge">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_send"
                        app:tint="@color/brand_violet_light" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_semibold"
                        android:maxLines="1"
                        android:text="@string/profile_refer_title"
                        android:textColor="@color/text_strong"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/jakarta_medium"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/profile_refer_sub"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_referral_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_users"
                        app:tint="@color/brand_violet_light" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/referInvitedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_extrabold"
                            android:includeFontPadding="false"
                            android:text="0"
                            android:textColor="@color/text_strong"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/profile_refer_invited"
                            android:textColor="@color/text_faint"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_referral_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        app:tint="@color/gold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/referStarsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_extrabold"
                            android:includeFontPadding="false"
                            android:text="0"
                            android:textColor="@color/gold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/jakarta_medium"
                            android:text="@string/profile_refer_stars"
                            android:textColor="@color/text_faint"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1.6"
                    android:background="@drawable/bg_referral_code"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta_semibold"
                            android:letterSpacing="0.18"
                            android:text="@string/profile_your_code"
                            android:textAllCaps="true"
                            android:textColor="@color/text_faint"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/referralCodeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/mono_bold"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.2"
                            android:maxLines="1"
                            android:textColor="@color/brand_violet_light"
                            android:textSize="20sp"
                            tools:text="XPJAJG" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/referralCopy"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/referral_copy"
                        android:padding="11dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/referralShare"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_referral_share"
                    android:clickable="true"
                    android:contentDescription="@string/referral_share"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_share"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/jakarta_bold"
                        android:text="@string/profile_refer_share"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Tapping this opens the full rule below; closed by default. -->
            <TextView
                android:id="@+id/referralHowToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="6dp"
                android:fontFamily="@font/jakarta_semibold"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:paddingEnd="6dp"
                android:text="@string/profile_refer_how"
                android:textColor="@color/brand_violet_light"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/brand_violet_light" />

            <LinearLayout
                android:id="@+id/referralRuleNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_info_note"
                android:orientation="horizontal"
                android:padding="11dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/brand_violet_light" />

                <TextView
                    android:id="@+id/referralRuleLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jakarta_medium"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/text_faint"
                    android:textSize="11.5sp"
                    tools:text="Your friend enters this code at signup." />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= Referrals row ================= -->
        <!-- Opens the Referrals page: the funnel and every invitee's progress. -->
        <LinearLayout
            android:id="@+id/referralsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_summary_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_referral_tile">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_users"
                    app:tint="@color/brand_violet_light" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/referralsRowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_semibold"
                    android:text="@string/profile_referrals_none"
                    android:textColor="@color/text_strong"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/referralsRowSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/profile_referrals_none_sub"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_faint" />

        </LinearLayout>

        <!-- ================= Claiming someone else's code ================= -->
        <LinearLayout
            android:id="@+id/referralClaimGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_semibold"
                android:text="@string/referral_claim_title"
                android:textColor="@color/text_strong"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/referralClaimSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jakarta_medium"
                android:text="@string/profile_claim_sub"
                android:textColor="@color/text_faint"
                android:textSize="11.5sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/referralInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/text_input_stroke_color"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="@color/text_faint"
                app:shapeAppearanceOverlay="@style/RoundedTextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/referralCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono_medium"
                    android:hint="@string/enter_referral_code"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:letterSpacing="0.12"
                    android:maxLength="6"
                    android:textColor="@color/text_strong"
                    android:textColorHint="@color/text_trace"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/submitReferralButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_accent_outline"
                android:fontFamily="@font/jakarta_semibold"
                android:gravity="center"
                android:text="@string/submit_referral"
                android:textColor="@color/brand_violet_light"
                android:textSize="13.5sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/referralClaimedNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_summary_card"
            android:drawablePadding="8dp"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="@string/referral_already_claimed"
            android:textColor="@color/text_faint"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_shield_check"
            app:drawableTint="@color/brand_violet"
            tools:visibility="visible" />

        <!--
            Shown INSTEAD of the claim input once this account has passed the
            unlock level without entering a code. Separate from the "already
            claimed" note above on purpose: nothing was claimed here, and
            saying otherwise would send somebody looking for stars that were
            never paid.
        -->
        <TextView
            android:id="@+id/referralExpiredNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_summary_card"
            android:drawablePadding="8dp"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="@string/referral_window_closed"
            android:textColor="@color/text_faint"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_info"
            app:drawableTint="@color/text_ghost"
            tools:visibility="gone" />

        <!-- ================= Account ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/jakarta_semibold"
            android:text="@string/profile_account"
            android:textColor="@color/text_strong"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_summary_card"
            android:divider="@drawable/divider_goal_row"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                android:id="@+id/rowTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_terms"
                android:textColor="@color/text_strong"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_row_terms"
                app:drawableEndCompat="@drawable/ic_row_caret" />

            <TextView
                android:id="@+id/rowPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_privacy"
                android:textColor="@color/text_strong"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_row_privacy"
                app:drawableEndCompat="@drawable/ic_row_caret" />

            <TextView
                android:id="@+id/rowSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_support"
                android:textColor="@color/text_strong"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_row_help"
                app:drawableEndCompat="@drawable/ic_row_caret" />

            <TextView
                android:id="@+id/rowPrivacyChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_privacy_choices"
                android:textColor="@color/text_strong"
                android:textSize="13.5sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_row_choices"
                app:drawableEndCompat="@drawable/ic_row_caret" />

            <TextView
                android:id="@+id/rowDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_delete_account"
                android:textColor="@color/row_danger"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_row_delete" />

            <TextView
                android:id="@+id/rowSignOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:fontFamily="@font/jakarta_medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_sign_out"
                android:textColor="@color/row_danger"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_row_signout" />

        </LinearLayout>

        <TextView
            android:id="@+id/profileVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="center"
            android:textColor="@color/text_wisp"
            android:textSize="10.5sp"
            tools:text="PixelPayout v1.0" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
