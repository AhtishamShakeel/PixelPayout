<?xml version="1.0" encoding="utf-8"?>
<!--
    One order on the Orders tab, with the Placed / Processing / Delivered
    tracker from the handoff.

    The tracker draws three steps but the server stores two states - see
    UserRepository.OrderStatus for why PENDING renders at Processing rather
    than inventing a state nobody writes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:background="@drawable/bg_summary_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/orderCode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_code_tile"
            android:fontFamily="@font/mono_bold"
            android:gravity="center"
            android:textColor="@color/brand_violet"
            android:textSize="12sp"
            tools:text="UC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orderAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_semibold"
                android:maxLines="1"
                android:textColor="@color/text_strong"
                android:textSize="13.5sp"
                tools:text="325 UC" />

            <TextView
                android:id="@+id/orderMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_medium"
                android:maxLines="2"
                android:textColor="@color/text_ghost"
                android:textSize="11.5sp"
                tools:text="PUBG Mobile - ID 5218840977 - today 14:02" />

        </LinearLayout>

        <TextView
            android:id="@+id/orderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_status_pending"
            android:fontFamily="@font/jakarta_semibold"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textAllCaps="true"
            android:textColor="@color/gold"
            android:textSize="10.5sp"
            tools:text="Processing" />

    </LinearLayout>

    <!-- The tracker. Three dots joined by two rules; the views are fixed and
         only their tints change, so there is no per-step inflation. -->
    <LinearLayout
        android:id="@+id/orderTracker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/trackerDot1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_tracker_dot_done" />

        <View
            android:id="@+id/trackerLine1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/stroke_strong" />

        <View
            android:id="@+id/trackerDot2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_tracker_dot_todo" />

        <View
            android:id="@+id/trackerLine2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/stroke_strong" />

        <View
            android:id="@+id/trackerDot3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_tracker_dot_todo" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/orderTrackerLabels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_medium"
            android:text="@string/order_step_placed"
            android:textColor="@color/text_ghost"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="center"
            android:text="@string/order_step_processing"
            android:textColor="@color/text_ghost"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_medium"
            android:gravity="end"
            android:text="@string/order_step_delivered"
            android:textColor="@color/text_ghost"
            android:textSize="10.5sp" />

    </LinearLayout>

    <!--
        The 48h delivery target, and the order id support will ask for.

        Only on a pending order: once it is delivered or declined the
        countdown is answering a question nobody is asking any more.
    -->
    <LinearLayout
        android:id="@+id/orderEtaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_history"
            app:tint="@color/text_ghost" />

        <TextView
            android:id="@+id/orderEta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/jakarta_medium"
            android:textColor="@color/text_faint"
            android:textSize="11.5sp"
            tools:text="Delivery within 41h" />

    </LinearLayout>

    <!-- The id support asks for. Tap to copy. -->
    <TextView
        android:id="@+id/orderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_code_tile"
        android:clickable="true"
        android:drawablePadding="7dp"
        android:focusable="true"
        android:fontFamily="@font/mono_medium"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        app:drawableEndCompat="@drawable/ic_copy"
        app:drawableTint="@color/text_ghost"
        tools:text="Order 7F3A9C21" />

    <!-- Only present on a declined order: the reason, and the refund. -->
    <TextView
        android:id="@+id/orderRejection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:fontFamily="@font/jakarta_medium"
        android:textColor="@color/text_faint"
        android:textSize="11.5sp"
        android:visibility="gone"
        tools:text="Wrong player ID. Your stars were returned."
        tools:visibility="visible" />

</LinearLayout>
